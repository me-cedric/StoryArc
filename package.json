{
  "name": "storyarc",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo tooling for StoryArc \u2014 native comic, manga and ebook readers for iOS and Android.",
  "license": "MIT",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "tokens:build": "node packages/design-tokens/scripts/build.mjs",
    "tokens:check": "node packages/design-tokens/scripts/build.mjs --check",
    "tokens:sync": "node scripts/sync-tokens.mjs",
    "a11y:android": "node scripts/a11y-scan.mjs",
    "capture:android": "node scripts/capture-android.mjs",
    "capture:ios": "node scripts/capture-ios.mjs",
    "a11y:selftest": "node scripts/a11y-scan.mjs --self-test",
    "pseudo:android": "node scripts/pseudo-locale.mjs",
    "pseudo:selftest": "node scripts/pseudo-locale.mjs --self-test",
    "tokens:verify": "node scripts/verify-tokens-in-sync.mjs",
    "spec:validate": "cd docs && openspec validate --all",
    "spec:list": "cd docs && openspec list --specs",
    "spec:guard": "node docs/agent-compass/scripts/openspec-guard.mjs .",
    "spec:guard:strict": "node docs/agent-compass/scripts/openspec-guard.mjs . --strict",
    "spec:status": "cd docs && openspec status --change",
    "openspec:workflows": "node scripts/openspec-workflows.mjs",
    "openspec:workflows:check": "node scripts/openspec-workflows.mjs --check",
    "openspec:workflows:selftest": "node scripts/openspec-workflows.mjs --self-test",
    "lint": "pnpm lines:check && pnpm tokens:check && pnpm brand:check && pnpm spec:validate && pnpm spec:guard && pnpm openspec:workflows:check && pnpm tokens:verify && pnpm fixtures:check && pnpm notices:check && pnpm libarchive:pin && pnpm lockfile:ios && pnpm corpus:check && pnpm kavita:check && pnpm opds:check && pnpm strings:ios",
    "lint:ios": "swiftlint lint --strict",
    "lint:android": "node scripts/gradle.mjs lint",
    "test:ios": "cd apps/ios/Packages/StoryArcKit && swift test",
    "test:ios:epub": "cd apps/ios/Packages/StoryArcEpub && xcodebuild test -scheme StoryArcEpub -destination 'platform=iOS Simulator,name=iPhone 17 Pro,OS=latest' -collect-test-diagnostics never -quiet",
    "test:android": "node scripts/gradle.mjs test",
    "build:android:tests": "node scripts/gradle.mjs assembleAndroidTest",
    "build:ios": "cd apps/ios && xcodegen generate && xcodebuild build -project StoryArc.xcodeproj -scheme StoryArc -destination 'generic/platform=iOS Simulator' -quiet",
    "build:ios:tests": "cd apps/ios && xcodegen generate && xcodebuild build-for-testing -project StoryArc.xcodeproj -scheme StoryArc -destination 'generic/platform=iOS Simulator' -quiet",
    "build:android": "node scripts/gradle.mjs assembleDebug",
    "check": "pnpm lint && pnpm lint:ios && pnpm test:ios && pnpm build:ios:tests && pnpm lint:android && pnpm test:android && pnpm build:android:tests",
    "prepare": "husky",
    "fixtures:build": "python3 packages/test-fixtures/scripts/generate.py",
    "fixtures:check": "python3 packages/test-fixtures/scripts/generate.py --check",
    "smoke:android": "node scripts/smoke-android.mjs",
    "smoke:android:a11y": "node scripts/smoke-android.mjs --a11y",
    "notices": "node scripts/notices.mjs",
    "corpus": "node scripts/corpus.mjs",
    "opds": "node scripts/opds-server.mjs",
    "kavita": "node scripts/kavita-server.mjs",
    "smb": "bash scripts/smb-server.sh",
    "corpus:check": "node scripts/corpus.mjs --self-test",
    "kavita:check": "node scripts/kavita-server.mjs --self-test",
    "opds:check": "node scripts/opds-server.mjs --self-test",
    "notices:check": "node scripts/notices.mjs --check",
    "strings:ios": "node scripts/ios-strings.mjs",
    "strings:ios:check": "node scripts/ios-strings.mjs --self-test",
    "lockfile:ios": "node scripts/ios-lockfile.mjs --check",
    "lockfile:ios:selftest": "node scripts/ios-lockfile.mjs --self-test",
    "libarchive:pin": "node scripts/libarchive-pin.mjs --check",
    "libarchive:pin:selftest": "node scripts/libarchive-pin.mjs --self-test",
    "libarchive:upstream": "node scripts/libarchive-pin.mjs --upstream",
    "gradle": "node scripts/gradle.mjs",
    "clean:builds": "node scripts/clean-build-data.mjs",
    "clean:builds:dry": "node scripts/clean-build-data.mjs --dry-run",
    "lines": "node scripts/line-cap.mjs --list",
    "lines:check": "node scripts/line-cap.mjs",
    "lines:selftest": "node scripts/line-cap.mjs --self-test",
    "brand:build": "swift scripts/brand-mark.swift --out .",
    "brand:check": "swift scripts/brand-mark.swift --out . --check"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@fission-ai/openspec": "^1.10.0",
    "husky": "^9.1.7"
  }
}
