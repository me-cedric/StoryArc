# Live servers, for the checks a mock cannot answer.
#
# Copy this file to `.env` and fill it in. `.env` is gitignored and must stay that way;
# only this example is committed, and it never holds a value.
#
# Nothing in the app reads these. They are for `pnpm live:check` and the device walks —
# the app itself takes a server from the reader and keeps the secret in the platform's
# secure store, which is what `sources` requires and what a device walk exercises.
#
# Every value here is a secret, including the OPDS URL: Kavita puts the key in the path.
# `scripts/live-check.mjs` redacts them, and no script may print one.

# --- Kavita -------------------------------------------------------------------
# The server's base address, as a reader would type it. No trailing slash.
STORYARC_KAVITA_URL=
# The API key from Kavita's user settings. Travels as a bearer header, never in a URL.
STORYARC_KAVITA_API_KEY=
# The full OPDS feed address. Kavita embeds the key in the path, so this is a secret too.
STORYARC_KAVITA_OPDS_URL=
# The key Kavita uses for cover images, where it differs from the API key.
STORYARC_KAVITA_IMAGE_KEY=

# --- SMB ----------------------------------------------------------------------
# Only needed for the automated share checks. Entering these on a device instead is
# better where you can: it is the path a reader takes, and it exercises the secure store.
STORYARC_SMB_HOST=
STORYARC_SMB_SHARE=
STORYARC_SMB_USER=
STORYARC_SMB_PASSWORD=
# Set to 1 when the share is configured to *require* SMB 3 encryption. That is the one
# setting that makes `SmbError.encryptionRequired` reachable, and the reason the refusal
# has never been observed.
STORYARC_SMB_REQUIRES_ENCRYPTION=
