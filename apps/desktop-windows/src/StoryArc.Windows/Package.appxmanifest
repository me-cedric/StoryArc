<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap5 uap10 rescap">

  <!-- Name and Publisher are placeholders. The Store association replaces both. -->
  <Identity
    Name="com.mecedric.StoryArc"
    Publisher="CN=StoryArc"
    Version="0.2.2.0" />

  <mp:PhoneIdentity PhoneProductId="6a1c3a52-5f0e-4d0a-9a8e-6f6c0b6e2f10" PhonePublisherId="00000000-0000-0000-0000-000000000000"/>

  <Properties>
    <DisplayName>StoryArc</DisplayName>
    <PublisherDisplayName>StoryArc</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <uap10:PackageIntegrity>
      <uap10:Content Enforcement="on"/>
    </uap10:PackageIntegrity>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.26100.0" MaxVersionTested="10.0.26226.0" />
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.26100.0" MaxVersionTested="10.0.26226.0" />
  </Dependencies>

  <Resources>
    <Resource Language="x-generate"/>
  </Resources>

  <Applications>
    <Application Id="App"
      Executable="$targetnametoken$.exe"
      EntryPoint="$targetentrypoint$">
      <uap:VisualElements
        DisplayName="StoryArc"
        Description="Read comics, ebooks and audiobooks from your own sources."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>

      <Extensions>
        <!-- desktop-clients task 2.42. The comics the core opens page by page, and nothing else: the
             package never claims a file it cannot open, so CB7 is absent here and refused by name when
             it arrives by drop or by command line. Name is the ProgID Windows derives the association
             from; StoryArc can register for these types but never sets itself as the default. The list
             is held to StoryArc.Interop.Opening.OpenRequest.Associated by the interop tests. -->
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="storyarc.comicarchive">
            <uap:DisplayName>Comic book archive</uap:DisplayName>
            <uap:Logo>Assets\StoreLogo.png</uap:Logo>
            <uap:SupportedFileTypes>
              <uap:FileType>.cbz</uap:FileType>
              <uap:FileType>.cbr</uap:FileType>
              <uap:FileType>.cbt</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
        <!-- desktop-clients task 5.8. A storyarc:// link names a publication or a source to open and nothing
             else. The app reads the link as a name in StoryArc.Interop.Opening.StoryArcLink; the interop
             tests hold this scheme to StoryArcLink.Scheme. -->
        <uap:Extension Category="windows.protocol">
          <uap:Protocol Name="storyarc">
            <uap:DisplayName>StoryArc</uap:DisplayName>
          </uap:Protocol>
        </uap:Extension>
        <!-- "storyarc C:\path\to\comic.cbz" from a terminal: the paths arrive as the launch arguments. -->
        <uap5:Extension Category="windows.appExecutionAlias" Executable="$targetnametoken$.exe" EntryPoint="$targetentrypoint$">
          <uap5:AppExecutionAlias>
            <uap5:ExecutionAlias Alias="storyarc.exe" />
          </uap5:AppExecutionAlias>
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <!-- Outbound connections to the sources the reader configured: internetClient for a catalogue or a server on the internet,
         privateNetworkClientServer for a share or a server on the home network. No inbound listening is used. -->
    <Capability Name="internetClient" />
    <Capability Name="privateNetworkClientServer" />
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
