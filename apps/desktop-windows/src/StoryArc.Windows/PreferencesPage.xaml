<?xml version="1.0" encoding="utf-8" ?>
<!-- The settings page (desktop-clients task 2.47; docs/designs/desktop/windows.md, section 5): a
     scrolling column clamped to 720, a search box on top, then the groups the search leaves. The rows
     are filled in code from PreferencesIndex, so the page and its tests share one list. The design
     names SettingsCard from the Community Toolkit; this page draws the same row with a Border, because
     the lane adds no package (the swap is one style, PreferenceRow). -->
<UserControl
    x:Class="StoryArc.Windows.PreferencesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="PreferenceRow" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
            <Setter Property="Padding" Value="16,12" />
        </Style>
        <Style x:Key="PreferenceNote" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="720" Margin="24,16" Spacing="16" HorizontalAlignment="Stretch">
            <TextBlock x:Name="PageTitle" Style="{ThemeResource TitleTextBlockStyle}" />
            <AutoSuggestBox
                x:Name="Search"
                QueryIcon="Find"
                TextChanged="OnSearchChanged"
                AutomationProperties.AutomationId="PreferencesSearch" />
            <StackPanel x:Name="Results" Spacing="8" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
