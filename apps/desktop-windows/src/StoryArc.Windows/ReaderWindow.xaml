<?xml version="1.0" encoding="utf-8" ?>
<!-- One reader window per publication (desktop-clients tasks 2.37 and 2.40). The page view is a
     ScrollViewer that zooms and pans, over one page or two facing pages that the core decodes.
     The artwork is the interface: the chrome is the title bar, the menu and one page label, and
     nothing tints the page. A page still decoding is an empty quiet frame, never a spinner. -->
<Window
    x:Class="StoryArc.Windows.ReaderWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:StoryArc.Windows">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid
        x:Name="Root"
        AllowDrop="True"
        DragOver="OnDragOver"
        Drop="OnDrop"
        PointerMoved="OnPointerMoved"
        PointerExited="OnPointerExited"
        PreviewKeyDown="OnKeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <local:AppMenu x:Name="Menu" Grid.Row="1" />

        <!-- Microsoft.UI.Xaml.Controls.ScrollViewer: ZoomMode gives pinch, Control and the wheel, and
             the zoom keys go through ChangeView. The limits are PageZoom.Floor and PageZoom.Ceiling. -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

        <ScrollViewer
            x:Name="PageScroller"
            ZoomMode="Enabled"
            MinZoomFactor="1"
            MaxZoomFactor="6"
            HorizontalScrollMode="Auto"
            VerticalScrollMode="Auto"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Auto"
            IsTabStop="True"
            SizeChanged="OnPageAreaSizeChanged"
            ViewChanged="OnViewChanged"
            DoubleTapped="OnDoubleTapped"
            AutomationProperties.AutomationId="ReaderPage">
            <Grid x:Name="PageFrame" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel x:Name="Spread" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Grid x:Name="FirstSlot">
                        <Border x:Name="FirstPlaceholder" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                            <TextBlock
                                x:Name="FirstReason"
                                Margin="24"
                                MaxWidth="320"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                TextAlignment="Center"
                                TextWrapping="Wrap"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Border>
                        <Image x:Name="FirstPage" Stretch="Uniform" />
                    </Grid>
                    <Grid x:Name="SecondSlot" Visibility="Collapsed">
                        <Border x:Name="SecondPlaceholder" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                            <TextBlock
                                x:Name="SecondReason"
                                Margin="24"
                                MaxWidth="320"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                TextAlignment="Center"
                                TextWrapping="Wrap"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Border>
                        <Image x:Name="SecondPage" Stretch="Uniform" />
                    </Grid>
                </StackPanel>
            </Grid>
        </ScrollViewer>

            <!-- The contents pane of a PDF (task 4.17): the outline and a search over the text layer, shown by Show Contents.
                 Absent for a comic, and for a scanned PDF with no outline; the search alone is absent without a text layer. -->
            <Grid
                x:Name="ContentsPane"
                Grid.Column="1"
                Width="340"
                Padding="12"
                RowSpacing="8"
                Visibility="Collapsed"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                AutomationProperties.AutomationId="PdfContents">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition x:Name="PageTextRow" Height="0" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="ContentsTitle" Style="{ThemeResource SubtitleTextBlockStyle}" />
                <AutoSuggestBox
                    x:Name="PdfSearchBox"
                    Grid.Row="1"
                    QueryIcon="Find"
                    QuerySubmitted="OnPdfSearch"
                    AutomationProperties.AutomationId="PdfSearch" />
                <ListView
                    x:Name="ContentsList"
                    Grid.Row="2"
                    SelectionMode="None"
                    IsItemClickEnabled="True"
                    ItemClick="OnContentsRowClick"
                    AutomationProperties.AutomationId="PdfContentsList" />
                <TextBlock
                    x:Name="ContentsNote"
                    Grid.Row="2"
                    TextWrapping="Wrap"
                    Visibility="Collapsed"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

                <!-- The text of the page shown, for a PDF with a text layer: the page is an image, so a selection is made
                     here, and what it offers is what a reflowable selection offers (ebook-reader, "Text-based PDF"). -->
                <TextBlock x:Name="PageTextTitle" Grid.Row="3" Style="{ThemeResource BodyStrongTextBlockStyle}" Visibility="Collapsed" />
                <ScrollViewer x:Name="PageTextScroller" Grid.Row="4" Visibility="Collapsed">
                    <RichTextBlock
                        x:Name="PageTextBlock"
                        IsTextSelectionEnabled="True"
                        TextWrapping="Wrap"
                        SelectionChanged="OnPageTextSelection"
                        AutomationProperties.AutomationId="PdfPageText" />
                </ScrollViewer>
                <StackPanel x:Name="PdfMarksPanel" Grid.Row="5" Spacing="6" Visibility="Collapsed">
                    <StackPanel x:Name="PdfSelectionBar" Spacing="4" Visibility="Collapsed" AutomationProperties.AutomationId="PdfSelection" />
                    <ScrollViewer MaxHeight="220">
                        <StackPanel x:Name="PdfHighlightsList" Spacing="4" />
                    </ScrollViewer>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- The one line of chrome under the page: where the reader is, and in grey what is unavailable. -->
        <StackPanel
            x:Name="PageChrome"
            Grid.Row="3"
            Orientation="Horizontal"
            HorizontalAlignment="Center"
            Spacing="16"
            Padding="8">
            <TextBlock
                x:Name="PageLabel"
                Style="{ThemeResource CaptionTextBlockStyle}"
                AutomationProperties.AutomationId="ReaderPageLabel"
                AutomationProperties.LiveSetting="Polite" />
            <TextBlock
                x:Name="UnavailableText"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Visibility="Collapsed" />
            <!-- A press that tries to select a word in a scanned PDF: told once that the file is images of pages. -->
            <TextBlock
                x:Name="ImagesOnlyText"
                Style="{ThemeResource CaptionTextBlockStyle}"
                TextWrapping="Wrap"
                MaxWidth="560"
                Visibility="Collapsed"
                AutomationProperties.AutomationId="ReaderImagesOnly"
                AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
    </Grid>
</Window>
