    "desktop.storage.removeAll": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle StoryArc-Daten entfernen …"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove All StoryArc Data…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminar todos los datos de StoryArc…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer toutes les données de StoryArc…"
          }
        }
      }
    },
    "desktop.storage.removeAll.body": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloads, Cover, Leseverlauf, Quellen mit ihren Passwörtern und Einstellungen werden entfernt. Ihre eigenen Dateien und Ordner bleiben unberührt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloads, covers, reading records, sources with their passwords, and preferences go. Your own files and folders are never touched."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se borran las descargas, las portadas, el registro de lectura, las fuentes con sus contraseñas y los ajustes. Tus archivos y carpetas nunca se tocan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les téléchargements, couvertures, l’historique, les sources avec leurs mots de passe et les réglages disparaissent. Vos fichiers et dossiers ne sont jamais touchés."
          }
        }
      }
    },
    "desktop.storage.removeAll.confirm": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Daten entfernen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove All Data"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminar todos los datos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout supprimer"
          }
        }
      }
    },
    "desktop.storage.removeAll.footer": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevor Sie StoryArc entfernen, bleibt damit nichts davon auf diesem Mac. Das System entfernt die App selbst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before you remove StoryArc, this leaves nothing of it on this Mac. The system removes the app itself."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de eliminar StoryArc, esto no deja nada de él en este Mac. El sistema elimina la app en sí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avant de supprimer StoryArc, ceci ne laisse rien de lui sur ce Mac. Le système supprime l’app elle-même."
          }
        }
      }
    },
    "desktop.storage.removeAll.title": {
      "localizations": {
        "de": {
          "stringUnit": {
