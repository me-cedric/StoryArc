    "desktop.privacy.clearHistory.body": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Position und jede Markierung als beendet auf diesem Mac wird vergessen, und die Liste der zuletzt geöffneten wird geleert. Ihre Dateien bleiben, wo sie sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every position and every finished mark on this Mac is forgotten, and the recent list is emptied. Your files stay where they are."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se olvidan todas las posiciones y marcas de terminado de este Mac, y se vacía la lista de recientes. Tus archivos se quedan donde están."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque position et chaque marque « terminé » de ce Mac sont oubliées, et la liste des récents est vidée. Vos fichiers restent où ils sont."
          }
        }
      }
    },
