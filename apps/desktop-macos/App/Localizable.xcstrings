    "desktop.drop.folder.body": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "StoryArc listet jede Publikation darin auf und beobachtet ihn weiter auf neue Dateien."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "StoryArc lists every publication in it and keeps watching it for new files."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "StoryArc muestra cada publicación que contiene y la vigila por si llegan archivos nuevos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "StoryArc liste chaque publication qu’il contient et le surveille pour les nouveaux fichiers."
          }
        }
      }
    },
    "desktop.drop.folder.cancel": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbrechen"
