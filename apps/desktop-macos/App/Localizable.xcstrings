  "strings": {
    "desktop.about.acknowledgements": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Danksagungen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Acknowledgements"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agradecimientos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remerciements"
          }
        }
      }
    },
    "desktop.about.acknowledgements.hint": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt den Lizenztext"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows the licence text"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra el texto de la licencia"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche le texte de la licence"
          }
        }
      }
    },
    "desktop.about.acknowledgements.unreadable": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Liste der Drittanbieter-Bibliotheken konnte aus diesem Build nicht gelesen werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The list of third-party libraries could not be read from this build."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer la lista de bibliotecas de terceros de esta compilación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La liste des bibliothèques tierces n’a pas pu être lue dans cette version."
          }
        }
      }
    },
