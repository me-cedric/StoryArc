    "desktop.storage.covers.body": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "StoryArc erzeugt sie bei Bedarf aus Ihren Büchern neu. Nichts von Ihrer Lektüre geht verloren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "StoryArc draws them again from your books when it needs them. Nothing you read is lost."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "StoryArc las vuelve a dibujar desde tus libros cuando las necesita. No se pierde nada de lo que lees."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "StoryArc les redessine à partir de vos livres quand il en a besoin. Rien de ce que vous lisez n’est perdu."
          }
        }
      }
    },
