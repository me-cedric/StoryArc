    "desktop.catalogue.untrusted.footer": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vertrauen Sie ihm nur, wenn Ihr Server diesen Fingerabdruck zeigt. StoryArc akzeptiert dieses Zertifikat dann nur für diesen Host."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trust it only if this fingerprint is the one your server shows. StoryArc then accepts this certificate for this host and no other."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Confía solo si esta huella es la que muestra tu servidor. StoryArc acepta entonces este certificado para este host y ningún otro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites-lui confiance seulement si cette empreinte est celle de votre serveur. StoryArc accepte alors ce certificat pour cet hôte et aucun autre."
          }
        }
      }
    },
