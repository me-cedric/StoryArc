    "desktop.appearance.footer": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Akzent färbt nur die Bedienelemente. Cover und Seiten behalten ihre eigenen Farben. Die Textgröße gilt für jedes Fenster."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The accent colours the controls only. Covers and pages keep their own colours. The text size applies to every window."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acento solo colorea los controles. Las portadas y las páginas conservan sus colores. El tamaño del texto se aplica a todas las ventanas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accentuation colore uniquement les commandes. Les couvertures et les pages gardent leurs couleurs. La taille du texte s’applique à toutes les fenêtres."
          }
        }
      }
    },
