    "desktop.refused.damaged %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ konnte nicht gelesen werden. Es ist möglicherweise beschädigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ could not be read. It may be damaged."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no se pudo leer. Puede estar dañado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n’a pas pu être lu. Il est peut-être endommagé."
          }
        }
      }
    },
    "desktop.refused.passwordProtected %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist durch ein Passwort geschützt. StoryArc verwaltet keine Archiv-Passwörter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is protected by a password. StoryArc does not manage archive passwords."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está protegido por una contraseña. StoryArc no gestiona contraseñas de archivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est protégé par un mot de passe. StoryArc ne gère pas les mots de passe d’archive."
          }
        }
      }
    },
    "desktop.refused.protected %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist kopiergeschützt, daher kann StoryArc es nicht öffnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is protected against copying, so StoryArc cannot open it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está protegido contra copia, así que StoryArc no puede abrirlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est protégé contre la copie, StoryArc ne peut donc pas l’ouvrir."
          }
        }
      }
    },
    "desktop.refused.solidArchive %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist ein solides Archiv, das StoryArc nicht seitenweise lesen kann."
