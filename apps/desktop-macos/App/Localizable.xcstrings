    "desktop.storage.records.body": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Lesepositionen und Gelesen-Markierungen auf diesem Mac werden entfernt. Ihre Bücher und Downloads bleiben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every reading position and finished mark on this Mac goes. Your books and downloads stay."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se borran todas las posiciones de lectura y marcas de leído de este Mac. Tus libros y descargas se conservan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les positions de lecture et marques de lecture terminée de ce Mac disparaissent. Vos livres et téléchargements restent."
          }
        }
