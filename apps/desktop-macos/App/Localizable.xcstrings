          }
        }
      }
    },
    "desktop.about.report.footer": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Meldung öffnet den Issue-Tracker mit App-Version, macOS-Version und „Mac“ ausgefüllt, und nichts über dich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A report opens the issue tracker with the app version, the macOS version and “Mac” filled in, and nothing about you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un informe abre el gestor de incidencias con la versión de la app, la versión de macOS y «Mac», y nada sobre ti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un signalement ouvre le suivi des problèmes avec la version de l’app, la version de macOS et « Mac », et rien sur vous."
          }
        }
      }
    },
