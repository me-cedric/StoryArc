    "desktop.empty.downloads.body": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heruntergeladene Publikationen lassen sich ohne Netz lesen. Laden Sie eine aus der Bibliothek herunter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloaded publications read without a network. Download one from the library."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las publicaciones descargadas se leen sin red. Descarga una desde la biblioteca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les publications téléchargées se lisent sans réseau. Téléchargez-en une depuis la bibliothèque."
          }
        }
      }
    },
