{
  "sourceLanguage": "en",
  "strings": {
    "desktop.empty.downloads.action": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bibliothek anzeigen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show Library"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar la biblioteca"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher la bibliothèque"
          }
        }
      }
    },
    "desktop.empty.downloads.body": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heruntergeladene Publikationen lassen sich ohne Netz lesen. Laden Sie eine aus der Bibliothek herunter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloaded publications read without a network. Download one from the library."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las publicaciones descargadas se leen sin red. Descarga una desde la biblioteca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les publications téléchargées se lisent sans réseau. Téléchargez-en une depuis la bibliothèque."
          }
        }
      }
    },
    "desktop.empty.downloads.title": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts heruntergeladen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing downloaded"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada descargado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun téléchargement"
          }
        }
      }
    },
    "desktop.empty.noSources.action": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelle hinzufügen…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a Source…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añadir una fuente…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouter une source…"
          }
        }
      }
    },
    "desktop.empty.noSources.body": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügen Sie einen Ordner, einen Katalog, einen Kavita-Server oder eine Freigabe hinzu, und die Publikationen erscheinen hier."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a folder, a catalogue, a Kavita server or a share, and its publications appear here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade una carpeta, un catálogo, un servidor Kavita o un recurso compartido, y sus publicaciones aparecerán aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez un dossier, un catalogue, un serveur Kavita ou un partage, et ses publications apparaîtront ici."
          }
        }
      }
    },
    "desktop.empty.noSources.title": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Quellen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No sources yet"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay fuentes"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune source pour le moment"
          }
        }
      }
    },
    "desktop.empty.search.body": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geben Sie etwas in das Suchfeld ein, um eine Publikation in allen Quellen zugleich zu finden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type in the search field to find a publication across every source at once."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe en el campo de búsqueda para encontrar una publicación en todas las fuentes a la vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez un mot dans le champ de recherche pour trouver une publication dans toutes les sources à la fois."
          }
        }
      }
    },
    "desktop.empty.search.title": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Quellen durchsuchen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search every source"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Buscar en todas las fuentes"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechercher dans toutes les sources"
          }
        }
      }
    },
