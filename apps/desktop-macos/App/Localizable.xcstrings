    "desktop.empty.noSources.body": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügen Sie einen Ordner, einen Katalog, einen Kavita-Server oder eine Freigabe hinzu, und die Publikationen erscheinen hier."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a folder, a catalogue, a Kavita server or a share, and its publications appear here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade una carpeta, un catálogo, un servidor Kavita o un recurso compartido, y sus publicaciones aparecerán aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez un dossier, un catalogue, un serveur Kavita ou un partage, et ses publications apparaîtront ici."
          }
        }
      }
    },
    "desktop.empty.noSources.title": {
      "localizations": {
