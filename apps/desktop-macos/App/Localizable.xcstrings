    "desktop.drop.folder.title %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ als Quelle hinzufügen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add “%@” as a source?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Añadir «%@» como fuente?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouter « %@ » comme source ?"
          }
        }
      }
    },
    "desktop.drop.listed %lld %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "StoryArc öffnet höchstens %1$lld Fenster auf einmal. Ebenfalls abgelegt: %2$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "StoryArc opens up to %1$lld windows at once. Also dropped: %2$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "StoryArc abre hasta %1$lld ventanas a la vez. También soltados: %2$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "StoryArc ouvre jusqu’à %1$lld fenêtres à la fois. Également déposés : %2$@"
          }
        }
      }
    },
    "desktop.empty.downloads.action": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bibliothek anzeigen"
