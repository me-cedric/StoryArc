    "desktop.privacy.stored": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "StoryArc speichert Ihre Positionen, Ordner und Einstellungen nur auf diesem Mac. Nichts wird an Orte gesendet, die Sie nicht eingerichtet haben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "StoryArc keeps your positions, your folders and your settings on this Mac only. Nothing is sent anywhere you did not set up."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "StoryArc guarda tus posiciones, tus carpetas y tus ajustes solo en este Mac. No se envía nada a ningún sitio que no hayas configurado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "StoryArc garde vos positions, vos dossiers et vos réglages sur ce Mac uniquement. Rien n’est envoyé ailleurs que là où vous l’avez configuré."
          }
        }
      }
    },
