    "desktop.refused.damaged %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ konnte nicht gelesen werden. Es ist möglicherweise beschädigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ could not be read. It may be damaged."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no se pudo leer. Puede estar dañado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n’a pas pu être lu. Il est peut-être endommagé."
          }
        }
      }
    },
    "desktop.refused.passwordProtected %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist durch ein Passwort geschützt. StoryArc verwaltet keine Archiv-Passwörter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is protected by a password. StoryArc does not manage archive passwords."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está protegido por una contraseña. StoryArc no gestiona contraseñas de archivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est protégé par un mot de passe. StoryArc ne gère pas les mots de passe d’archive."
          }
        }
      }
    },
    "desktop.refused.protected %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist kopiergeschützt, daher kann StoryArc es nicht öffnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is protected against copying, so StoryArc cannot open it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está protegido contra copia, así que StoryArc no puede abrirlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est protégé contre la copie, StoryArc ne peut donc pas l’ouvrir."
          }
        }
      }
    },
    "desktop.refused.solidArchive %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist ein solides Archiv, das StoryArc nicht seitenweise lesen kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is a solid archive that StoryArc cannot read page by page."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ es un archivo sólido que StoryArc no puede leer página a página."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est une archive solide que StoryArc ne peut pas lire page par page."
          }
        }
      }
    },
    "desktop.refused.unreadable %@ %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ konnte nicht geöffnet werden. StoryArc liest %2$@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ could not be opened. StoryArc reads %2$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ no se pudo abrir. StoryArc lee %2$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ n’a pas pu être ouvert. StoryArc lit les formats %2$@."
          }
        }
      }
    },
    "desktop.refused.unsupported %@ %@ %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ist eine %2$@-Datei, die StoryArc nicht liest. StoryArc liest %3$@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is a %2$@ file, which StoryArc does not read. It reads %3$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ es un archivo %2$@, que StoryArc no lee. Lee %3$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ est un fichier %2$@, que StoryArc ne lit pas. Il lit les formats %3$@."
