    "desktop.reading.clickZones.footer": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Klick auf das linke oder rechte Drittel einer Seite blättert, wie ein Tippen auf dem Telefon. Die Mitte zeigt die Bedienelemente."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A click on the left or right third of a page turns it, as a tap does on a phone. The middle shows the controls."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un clic en el tercio izquierdo o derecho de una página la pasa, como un toque en un teléfono. El centro muestra los controles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un clic sur le tiers gauche ou droit d’une page la tourne, comme un toucher sur un téléphone. Le milieu affiche les commandes."
          }
        }
      }
    },
