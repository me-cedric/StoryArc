    "desktop.downloads.footer": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine getaktete Verbindung ist eine, die das System als teuer oder begrenzt kennzeichnet, etwa der Hotspot eines Telefons oder der Modus für wenig Daten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A metered connection is one the system marks as costly or limited, such as a phone’s hotspot or Low Data Mode."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una conexión medida es la que el sistema marca como costosa o limitada, como el punto de acceso de un teléfono o el modo de datos reducidos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une connexion limitée est une connexion que le système signale comme coûteuse ou restreinte, comme le partage de connexion d’un téléphone ou le mode données réduites."
          }
        }
      }
    },
    "desktop.downloads.metered": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur über nicht getaktete Verbindungen herunterladen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download only on connections that are not metered"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descargar solo con conexiones no medidas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Télécharger uniquement sur les connexions non limitées"
          }
        }
      }
    },
    "desktop.drop.folder.add": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
