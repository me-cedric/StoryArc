    "desktop.sync.footer": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Start und Beenden führt StoryArc Ihre Lesepositionen, Regale und Einstellungen mit einem Dokument an diesem Ort zusammen. Bei geschlossenem StoryArc wird nichts synchronisiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At start and at quit, StoryArc merges your reading positions, shelves and settings with one document in that place. Nothing syncs while StoryArc is closed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al abrir y al salir, StoryArc combina tus posiciones de lectura, estanterías y ajustes con un documento en ese lugar. Nada se sincroniza con StoryArc cerrado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À l’ouverture et à la fermeture, StoryArc fusionne vos positions de lecture, étagères et réglages avec un document à cet endroit. Rien ne se synchronise quand StoryArc est fermé."
          }
        }
      }
    },
