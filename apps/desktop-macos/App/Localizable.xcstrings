    "desktop.about.free": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "StoryArc ist vollständig kostenlos und Open Source, ohne Bezahlstufe und ohne Werbung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "StoryArc is completely free and open source, with no paid tier and no advertising."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "StoryArc es totalmente gratuito y de código abierto, sin nivel de pago y sin publicidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "StoryArc est entièrement gratuit et open source, sans offre payante ni publicité."
          }
        }
      }
    },
