            "value": "Effacer votre historique de lecture ?"
          }
        }
      }
    },
    "desktop.privacy.diagnosticLater": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Sichern einer Diagnose in eine Datei kommt in einer späteren Version."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saving a diagnostic to a file comes in a later version."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardar un diagnóstico en un archivo llegará en una versión posterior."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’enregistrement d’un diagnostic dans un fichier arrivera dans une prochaine version."
          }
        }
      }
    },
    "desktop.privacy.stored": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "StoryArc speichert Ihre Positionen, Ordner und Einstellungen nur auf diesem Mac. Nichts wird an Orte gesendet, die Sie nicht eingerichtet haben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "StoryArc keeps your positions, your folders and your settings on this Mac only. Nothing is sent anywhere you did not set up."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "StoryArc guarda tus posiciones, tus carpetas y tus ajustes solo en este Mac. No se envía nada a ningún sitio que no hayas configurado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "StoryArc garde vos positions, vos dossiers et vos réglages sur ce Mac uniquement. Rien n’est envoyé ailleurs que là où vous l’avez configuré."
          }
        }
      }
    },
    "desktop.quit.download.body": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Sie beenden, hält er an und läuft beim nächsten Öffnen von StoryArc weiter. Bereits Geladenes bleibt erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you quit, it pauses now and resumes the next time you open StoryArc. What arrived so far is kept."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si sales, se pausa y continúa la próxima vez que abras StoryArc. Lo que ya llegó se conserva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous quittez, il se suspend et reprend à la prochaine ouverture de StoryArc. Ce qui est arrivé est conservé."
          }
        }
      }
    },
