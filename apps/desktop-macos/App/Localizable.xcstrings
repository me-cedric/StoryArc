    "desktop.storage.downloads.body": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Dateien werden von diesem Mac entfernt und die Warteschlange geleert. Ihre Lesepositionen bleiben, und jedes Buch lässt sich erneut laden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The files leave this Mac and the queue empties. Your reading positions stay, and each book can be downloaded again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos salen de este Mac y la cola se vacía. Tus posiciones de lectura se conservan y cada libro puede descargarse de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers quittent ce Mac et la file se vide. Vos positions de lecture restent, et chaque livre peut être téléchargé de nouveau."
          }
        }
      }
    },
    "desktop.storage.downloads.confirm": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Downloads entfernen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove every download?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar todas las descargas?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer tous les téléchargements ?"
          }
        }
      }
    },
    "desktop.storage.footer": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles bleibt im eigenen Ordner von StoryArc auf diesem Mac, außerhalb jedes Ordners, der zwischen Geräten synchronisiert wird. Downloads sind von Backups ausgenommen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything stays inside StoryArc’s own folder on this Mac, out of any folder that syncs between machines. Downloads are left out of backups."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo se queda en la carpeta de StoryArc en este Mac, fuera de cualquier carpeta que se sincronice entre equipos. Las descargas quedan fuera de las copias de seguridad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout reste dans le dossier de StoryArc sur ce Mac, hors de tout dossier synchronisé entre machines. Les téléchargements sont exclus des sauvegardes."
          }
        }
      }
    },
    "desktop.storage.full": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Mac ist fast voll. StoryArc behält, was es hat, und wartet auf Platz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Mac is almost full. StoryArc keeps what it has and waits for room."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac está casi lleno. StoryArc conserva lo que tiene y espera a que haya espacio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce Mac est presque plein. StoryArc garde ce qu’il a et attend de la place."
          }
        }
      }
    },
    "desktop.storage.full.clear": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cover und zwischengespeicherte Seiten löschen"
