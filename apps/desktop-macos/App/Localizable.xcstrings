    "desktop.about.report": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Problem melden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Report a Problem"
