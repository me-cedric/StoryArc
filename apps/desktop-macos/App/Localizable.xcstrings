    "desktop.reading.clickZones": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Durch Klick auf die Ränder blättern"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn pages by clicking the edges"
          }
        },
