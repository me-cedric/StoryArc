<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      Without a keychain access group the app has no keychain at all: `SecItemAdd` answers
      `errSecMissingEntitlement` and every secret is silently discarded. That is what was
      happening — sources were saved with no credential reference and their servers refused
      them on the next launch, and nothing said so.
    -->
    <!--
      The App Group the home-screen widget reads the reading snapshot from (ADR-0011).
      `WidgetSigningTests` holds it equal to `ReadingSnapshot.appGroup` and the widget's file.
    -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.com.mecedric.storyarc</string>
    </array>
    <key>keychain-access-groups</key>
    <array>
        <string>$(AppIdentifierPrefix)com.mecedric.storyarc</string>
    </array>
</dict>
</plist>
