    "home.keepReading": {
      "extractionState": "manual",
      "comment": "Home's hero: the publications the reader stopped part-way through.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weiterlesen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue reading"
          }
        },
        "es": {
