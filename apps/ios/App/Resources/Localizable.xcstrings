{
  "sourceLanguage": "en",
  "strings": {
    "downloads.cancel": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbrechen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annuler"
          }
        }
      }
    },
    "downloads.empty": {
      "extractionState": "manual",
      "comment": "Nothing is readable offline yet. Android says the same sentence.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch nichts auf diesem Gerät. Ein Buch, das Sie aus einer Online-Bibliothek öffnen, wird hier behalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is on this device yet. A book you open from an online library is kept here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay nada en este dispositivo. Un libro que abras desde una biblioteca en línea se guarda aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n’est encore sur cet appareil. Un livre ouvert depuis une bibliothèque en ligne est conservé ici."
          }
        }
      }
    },
    "downloads.failed %@ %lld": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach %2$lld Versuchen fehlgeschlagen: %1$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Failed after %2$lld attempts: %1$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Falló tras %2$lld intentos: %1$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échec après %2$lld tentatives : %1$@"
          }
        }
      }
    },
    "downloads.inFlight": {
      "extractionState": "manual",
      "comment": "The queue, pinned above the shelf while anything is arriving.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kommt gerade an"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Coming down now"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Llegando ahora"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En cours de réception"
          }
        }
      }
    },
    "downloads.moveEarlier %@": {
      "extractionState": "manual",
      "localizations": {
