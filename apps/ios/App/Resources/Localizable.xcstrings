        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annuler"
          }
        }
      }
    },
    "downloads.empty": {
      "extractionState": "manual",
      "comment": "Nothing is readable offline yet. Android says the same sentence.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch nichts auf diesem Gerät. Ein Buch, das Sie aus einer Online-Bibliothek öffnen, wird hier behalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is on this device yet. A book you open from an online library is kept here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay nada en este dispositivo. Un libro que abras desde una biblioteca en línea se guarda aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n’est encore sur cet appareil. Un livre ouvert depuis une bibliothèque en ligne est conservé ici."
          }
        }
      }
    },
    "downloads.failed %@ %lld": {
      "extractionState": "manual",
      "comment": "Three attempts is the ceiling `offline-downloads` sets, so one of them is a real case and reads wrong as \"1 attempts\". Android draws the same sentence through `R.plurals.downloads_failed`.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach %#@attempts@ fehlgeschlagen: %1$@"
          },
          "substitutions": {
            "attempts": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg Versuch"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg Versuchen"
                    }
                  }
                }
              }
            }
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Failed after %#@attempts@: %1$@"
          },
          "substitutions": {
            "attempts": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg attempt"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg attempts"
                    }
                  }
                }
              }
            }
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Falló tras %#@attempts@: %1$@"
          },
          "substitutions": {
            "attempts": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "many": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg intentos"
                    }
                  },
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg intento"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg intentos"
                    }
                  }
                }
              }
            }
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échec après %#@attempts@ : %1$@"
          },
          "substitutions": {
            "attempts": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "many": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg tentatives"
                    }
                  },
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg tentative"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg tentatives"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "downloads.inFlight": {
      "extractionState": "manual",
      "comment": "The queue, pinned above the shelf while anything is arriving.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kommt gerade an"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Coming down now"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Llegando ahora"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En cours de réception"
          }
        }
      }
    },
