    "downloads.remove": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Download entfernen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove download"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminar la descarga"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer le téléchargement"
          }
        }
      }
    },
    "downloads.remove.action %@": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Download von %@ entfernen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove the download of %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminar la descarga de %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer le téléchargement de %@"
          }
        }
      }
    },
    "downloads.remove.body %@": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies löscht die Kopie von %@ auf diesem Gerät. Ihre Leseposition bleibt erhalten, und es kann erneut heruntergeladen werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This deletes the copy of %@ on this device. Your reading position is kept, and it can be downloaded again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina la copia de %@ en este dispositivo. Se conserva tu posición de lectura, y se puede descargar otra vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime la copie de %@ sur cet appareil. Votre position de lecture est conservée, et il peut être téléchargé à nouveau."
          }
        }
      }
    },
    "downloads.remove.body.imported %@ %@": {
      "comment": "Shown before deleting a copy the reader imported. The first value is the title, the second the space it frees.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies löscht die von StoryArc aufbewahrte Kopie von %@ und gibt %@ frei. Die Originaldatei anderswo auf Ihrem Gerät bleibt unberührt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This deletes the copy of %@ that StoryArc keeps, freeing %@. The original file elsewhere on your device is not touched."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina la copia de %@ que guarda StoryArc y libera %@. El archivo original en otro lugar de su dispositivo no se toca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime la copie de %@ conservée par StoryArc et libère %@. Le fichier d’origine ailleurs sur votre appareil n’est pas touché."
          }
        }
      }
    },
    "downloads.remove.body.unfinished %@": {
      "comment": "Shown before removing a transfer that failed. It has already stopped, so it is removed rather than stopped, and the sentence says what a reader gets back: nothing, because nothing arrived.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts von %@ ist auf diesem Gerät angekommen. Er verlässt die Warteschlange, und er kann erneut heruntergeladen werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing of %@ reached this device. It leaves the queue, and it can be downloaded again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No llegó nada de %@ a este dispositivo. Sale de la cola, y se puede descargar otra vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien de %@ n’est arrivé sur cet appareil. Il quitte la file d’attente, et il peut être téléchargé à nouveau."
          }
        }
      }
    },
    "downloads.remove.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diesen Download entfernen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove this download?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar esta descarga?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer ce téléchargement ?"
          }
        }
      }
    },
    "downloads.removed %@": {
      "extractionState": "manual",
      "comment": "The ten-second undo after a download is removed.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ von diesem Gerät entfernt. Ihre Stelle bleibt erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” removed from this device. Your place is kept."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» eliminado de este dispositivo. Se conserva tu posición."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » supprimé de cet appareil. Votre place est conservée."
          }
        }
      }
    },
    "downloads.retry": {
      "comment": "The failed row's first control. The app target's own copy of LibraryFeature's downloads.retry, because the queue row is drawn here and a key looked up in the wrong bundle renders as the key.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erneut"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retry"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reintentar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réessayer"
          }
        }
      }
    },
