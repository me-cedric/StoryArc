          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reprendre la lecture"
          }
        }
      }
    },
    "home.nothingOpen": {
      "extractionState": "manual",
      "comment": "Home with nothing in progress. Absent rather than empty is the rule for the sections; this is the one line that replaces them.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch nichts geöffnet. Wählen Sie etwas aus Ihrer Bibliothek."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing open yet. Pick something from your library."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada abierto todavía. Elige algo de tu biblioteca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien d'ouvert pour l'instant. Choisissez quelque chose dans votre bibliothèque."
          }
        }
      }
    },
