        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Adelantar «%@»"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avancer « %@ »"
          }
        }
      }
    },
    "downloads.moveLater %@": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ nach hinten"
