            "value": "Go to your library"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ir a tu biblioteca"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aller à votre bibliothèque"
          }
        }
      }
    },
