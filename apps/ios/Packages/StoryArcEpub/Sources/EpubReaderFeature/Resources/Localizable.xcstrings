    "theme.preview.description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Beispielseite mit den von Ihnen gewählten Einstellungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A sample page in the settings you have chosen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una página de ejemplo con los ajustes que has elegido."
          }
        },
        "fr": {
