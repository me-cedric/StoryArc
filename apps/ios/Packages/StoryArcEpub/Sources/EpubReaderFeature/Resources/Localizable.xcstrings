          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utiliser la typographie de StoryArc"
          }
        }
      }
    },
    "theme.publisherStyles.reason": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Original behält das Buch genau so, wie es veröffentlicht wurde, deshalb erreichen diese Regler die Seite nicht. Die Textgröße schon."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Original keeps the book exactly as it was published, so these controls cannot reach the page. Text size still can."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Original mantiene el libro exactamente como se publicó, así que estos controles no llegan a la página. El tamaño del texto sí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Original conserve le livre exactement tel qu’il a été publié : ces réglages ne peuvent donc pas atteindre la page. La taille du texte, si."
          }
        }
      }
