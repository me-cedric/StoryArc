    "theme.publisherStyles.reason": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Original behält die Publikation genau so, wie sie veröffentlicht wurde. Diese Einstellungen erreichen die Seite daher nicht. Die Textgröße schon."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Original keeps the publication exactly as it was published, so these controls cannot reach the page. Text size still can."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Original conserva la publicación tal como se publicó, así que estos ajustes no llegan a la página. El tamaño del texto sí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Original conserve la publication telle qu’elle a été publiée : ces réglages n’ont donc aucun effet. La taille du texte, si."
          }
        }
      }
    },
