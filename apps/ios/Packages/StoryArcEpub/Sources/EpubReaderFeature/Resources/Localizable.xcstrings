    "theme.pageColour.belowAAA": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lesbar, aber unter dem Verhältnis 7 zu 1, das jedes mitgelieferte Thema erreicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Readable, but below the 7 to 1 that every built-in theme meets."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Legible, pero por debajo del 7 a 1 que cumple cada tema incluido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisible, mais en dessous du 7 pour 1 que respecte chaque thème fourni."
          }
        }
      }
    },
