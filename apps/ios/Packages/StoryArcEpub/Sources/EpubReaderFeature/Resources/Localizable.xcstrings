    "theme.pageColour.refused %1$@ %2$@": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht angewendet. %1$@ zu 1 liegt unter den %2$@ zu 1, die zum bequemen Lesen nötig sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not applied. %1$@ to 1 is below the %2$@ to 1 needed to read comfortably."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No aplicado. %1$@ a 1 está por debajo del %2$@ a 1 necesario para leer con comodidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Non appliqué. %1$@ pour 1 est en dessous du %2$@ pour 1 nécessaire pour lire confortablement."
          }
        }
      }
    },
