          "stringUnit" : {
            "state" : "translated",
            "value" : "Stopped reading “%@” aloud."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se dejó de leer «%@» en voz alta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lecture à voix haute de « %@ » arrêtée."
