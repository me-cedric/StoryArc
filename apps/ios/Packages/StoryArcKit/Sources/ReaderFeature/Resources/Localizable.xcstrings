{
  "sourceLanguage": "en",
  "strings": {
    "reader.close": {
      "comment": "Leaves the reader and returns to the library.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerrar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fermer"
          }
        }
      }
    },
    "reader.end.back": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zurück zur letzten Seite"
          }
        },
        "en": {
          "stringUnit": {
