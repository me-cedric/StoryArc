    "reader.page %lld %lld": {
      "comment": "The page indicator. First number is the current page, second is the total.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld von %2$lld"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld of %2$lld"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld de %2$lld"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld sur %2$lld"
          }
        }
      }
    },
    "reader.pageUnavailable": {
      "comment": "Shown in place of a page whose bytes are missing or will not decode. publication-formats requires saying so rather than showing a blank.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Seite konnte nicht gelesen werden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This page could not be read"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer esta página"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette page n'a pas pu être lue"
          }
        }
      }
    },
    "reader.rightToLeft": {
      "comment": "Spoken by VoiceOver so the reading direction is not something a user has to infer from the gesture.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von rechts nach links"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Right to left"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De derecha a izquierda"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "De droite à gauche"
          }
        }
      }
    }
