    "reader.pageUnavailable": {
      "comment": "Shown in place of a page whose bytes are missing or will not decode. publication-formats requires saying so rather than showing a blank.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Seite konnte nicht gelesen werden"
