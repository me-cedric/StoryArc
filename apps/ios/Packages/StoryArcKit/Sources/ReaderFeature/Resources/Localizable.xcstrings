    "reader.transition.noCurl": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blättern wird hier nicht angeboten: dieses Gerät kann es nicht flüssig genug darstellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Curl is not offered here: this device cannot draw it smoothly enough to be worth it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El doblez no se ofrece aquí: este dispositivo no puede dibujarlo con suficiente fluidez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La pliure n’est pas proposée ici : cet appareil ne peut pas la dessiner assez fluidement."
          }
        }
