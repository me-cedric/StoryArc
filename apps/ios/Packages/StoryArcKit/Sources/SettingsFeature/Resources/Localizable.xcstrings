    "downloads.none": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts ist heruntergeladen. Eine Publikation aus einem Katalog bleibt auf dem Gerät, sobald Sie sie öffnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is downloaded. A publication from a catalogue is kept on the device once you open it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay nada descargado. Una publicación de un catálogo se conserva en el dispositivo en cuanto la abre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n’est téléchargé. Une publication d’un catalogue est conservée sur l’appareil dès que vous l’ouvrez."
          }
        }
      }
    },
