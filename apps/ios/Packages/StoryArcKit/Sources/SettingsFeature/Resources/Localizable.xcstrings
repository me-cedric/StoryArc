      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lesethema an die App anpassen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Match the reading theme to the app"
          }
        },
        "es": {
          "stringUnit": {
