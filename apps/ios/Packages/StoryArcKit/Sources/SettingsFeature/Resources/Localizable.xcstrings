    "reading.tapZones": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen auf die Seite blättert um"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapping the page turns it"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocar la página la pasa"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toucher la page la tourne"
          }
        }
      }
    },
    "reading.tapZones.note": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardmäßig an: Tippen Sie auf das linke oder rechte Drittel der Seite, um umzublättern, und auf das mittlere Drittel, um die Bedienelemente zu zeigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On by default: tap the left or right third of the page to turn it, and the middle third to show the controls."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activado por defecto: toque el tercio izquierdo o derecho de la página para pasarla, y el tercio central para mostrar los controles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activé par défaut : touchez le tiers gauche ou droit de la page pour la tourner, et le tiers central pour afficher les commandes."
          }
        }
      }
    },
    "reading.volumeButtons": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lautstärketasten blättern"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Volume buttons turn pages"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los botones de volumen cambian de página"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les touches de volume tournent les pages"
          }
        }
      }
    },
    "reading.volumeButtons.note": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardmäßig aus: beim Lesen würden die Lautstärketasten die Lautstärke nicht mehr ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off by default: while reading, the volume buttons would stop changing the volume."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado por defecto: al leer, los botones de volumen dejarían de ajustar el volumen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé par défaut : pendant la lecture, les touches de volume ne régleraient plus le volume."
          }
        }
      }
    },
    "reading.volumeButtons.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lautstärketasten können auf iOS nicht blättern: das System reserviert sie, und der einzige Umweg bricht, sobald etwas anderes Audio abspielt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Volume buttons cannot turn pages on iOS: the system reserves them, and the only way around that breaks whenever something else plays audio."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los botones de volumen no pueden cambiar de página en iOS: el sistema los reserva, y el único atajo se rompe cuando algo más reproduce audio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les touches de volume ne peuvent pas tourner les pages sur iOS : le système les réserve, et le seul contournement casse dès qu’un autre son est joué."
          }
        }
      }
    },
