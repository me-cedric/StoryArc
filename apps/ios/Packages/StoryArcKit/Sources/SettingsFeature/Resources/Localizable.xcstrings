            "state": "translated",
            "value": "BD et pages fixes"
          }
        }
      }
    },
    "reading.defaults.note": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gilt für Serien, die Sie noch nicht geöffnet haben. Ein beim Lesen gewähltes Thema bleibt bei dieser Serie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applies to series you have not opened before. A theme you set while reading stays with that series."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se aplica a series que no ha abierto antes. Un tema elegido al leer se queda con esa serie."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S’applique aux séries jamais ouvertes. Un thème choisi pendant la lecture reste attaché à cette série."
          }
        }
      }
    },
    "reading.defaults.pending": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lesevorgaben für neue Serien fehlen noch. Ein beim Lesen gewähltes Thema gilt bereits für die ganze Serie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reading defaults for new series are not here yet. A theme you set while reading already applies to the whole series."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los ajustes de lectura por defecto aún no están aquí. Un tema elegido al leer ya se aplica a toda la serie."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les réglages de lecture par défaut ne sont pas encore ici. Un thème choisi pendant la lecture s’applique déjà à toute la série."
          }
        }
      }
    },
