    "privacy.cache.note": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seiten, die StoryArc bereithält, damit sie schnell öffnen. Werden beim Lesen neu aufgebaut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pages StoryArc kept ready so they open fast. Rebuilt as you read."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Páginas que StoryArc deja preparadas para que se abran rápido. Se reconstruyen a medida que lees."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des pages que StoryArc garde prêtes pour qu’elles s’ouvrent vite. Reconstituées à mesure que vous lisez."
          }
        }
      }
    },
