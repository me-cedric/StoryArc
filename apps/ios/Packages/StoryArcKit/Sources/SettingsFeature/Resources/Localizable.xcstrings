    "reading.defaults.fixed": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Comics und feste Seiten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Comics and fixed pages"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cómics y páginas fijas"
          }
        },
        "fr": {
