    "settings.reset": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einstellungen zurücksetzen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reset settings"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restablecer ajustes"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réinitialiser les réglages"
          }
        }
      }
    },
    "settings.reset.body": {
      "comment": "one-vocabulary 4.1/15.11, D31: the same words as Android's settings_reset_body, which breaks them into two paragraphs. A confirmation body that stopped at \"No files\" at the largest text size does not scroll, so the blank line is not free here. A presentation difference, not a wording one.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erscheinungsbild, Leseeinstellungen und die Vorgaben für neue Serien gehen auf den Anfangszustand zurück. Ihre Bibliotheken, Downloads, der Lesefortschritt und die beim Lesen gewählten Themen bleiben unberührt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Appearance, reading preferences and the defaults for new series go back to how they started. Your libraries, downloads, reading progress and the themes you chose while reading are not affected."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La apariencia, las preferencias de lectura y los ajustes por defecto de series nuevas vuelven a su estado inicial. Tus bibliotecas, descargas, progreso de lectura y los temas elegidos al leer no se ven afectados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’apparence, les préférences de lecture et les réglages par défaut des nouvelles séries reviennent à leur état initial. Vos bibliothèques, téléchargements, progression de lecture et les thèmes choisis pendant la lecture ne sont pas touchés."
          }
        }
      }
    },
    "settings.reset.confirm": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zurücksetzen"
          }
