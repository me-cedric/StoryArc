    "downloads.manageInDestination": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gezählt wird, was StoryArc heruntergeladen oder importiert hat. Ein Ordner, den Sie hinzugefügt haben, ist ebenfalls ohne Netz lesbar, und seine Dateien werden hier nicht gezählt. Alles auf diesem Gerät, und alles, was noch ankommt, finden Sie unter Downloads."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This counts what StoryArc downloaded or imported. A folder you added is readable without a network too, and its files are not counted here. Everything on this device, and anything still arriving, is in Downloads."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto cuenta lo que StoryArc ha descargado o importado. Una carpeta que hayas añadido también se puede leer sin red, y sus archivos no se cuentan aquí. Todo lo que hay en este dispositivo, y todo lo que aún está llegando, está en Descargas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceci compte ce que StoryArc a téléchargé ou importé. Un dossier que vous avez ajouté est lui aussi lisible sans réseau, et ses fichiers ne sont pas comptés ici. Tout ce qui est sur cet appareil, et tout ce qui arrive encore, se trouve dans Téléchargements."
          }
        }
      }
    },
