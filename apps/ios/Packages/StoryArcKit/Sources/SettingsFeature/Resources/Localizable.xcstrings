        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Système"
          }
        }
      }
    },
    "privacy.pending": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Daten löschen und einen Diagnosebericht exportieren sind noch nicht gebaut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clearing data and exporting a diagnostic are not built yet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Borrar datos y exportar un diagnóstico aún no están desarrollados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’effacement des données et l’export d’un diagnostic ne sont pas encore développés."
          }
        }
      }
    },
    "privacy.sources": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Daten verlassen dieses Gerät nur zu den Quellen, die Sie selbst eingerichtet haben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Data leaves this device only to the sources you configured yourself."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los datos salen de este dispositivo solo hacia las fuentes que usted configuró."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données ne quittent cet appareil que vers les sources que vous avez vous-même configurées."
          }
        }
      }
    },
    "privacy.statement": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "StoryArc hat kein Konto, kein Backend, keine Analyse und keine Absturzberichte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "StoryArc has no account, no backend, no analytics and no crash reporting."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "StoryArc no tiene cuenta, ni backend, ni analítica, ni informes de errores."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "StoryArc n’a aucun compte, aucun serveur, aucune analyse et aucun rapport de plantage."
          }
        }
      }
    },
    "reading.defaults.pending": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lesevorgaben für neue Serien fehlen noch. Ein beim Lesen gewähltes Thema gilt bereits für die ganze Serie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reading defaults for new series are not here yet. A theme you set while reading already applies to the whole series."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los ajustes de lectura por defecto aún no están aquí. Un tema elegido al leer ya se aplica a toda la serie."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les réglages de lecture par défaut ne sont pas encore ici. Un thème choisi pendant la lecture s’applique déjà à toute la série."
          }
        }
      }
    },
    "reading.volumeButtons": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lautstärketasten blättern"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Volume buttons turn pages"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los botones de volumen cambian de página"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les touches de volume tournent les pages"
          }
        }
      }
    },
    "reading.volumeButtons.note": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardmäßig aus: beim Lesen würden die Lautstärketasten die Lautstärke nicht mehr ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off by default: while reading, the volume buttons would stop changing the volume."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado por defecto: al leer, los botones de volumen dejarían de ajustar el volumen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé par défaut : pendant la lecture, les touches de volume ne régleraient plus le volume."
          }
        }
      }
    },
