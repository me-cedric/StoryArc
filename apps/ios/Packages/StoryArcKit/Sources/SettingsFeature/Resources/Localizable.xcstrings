          "stringUnit": {
            "state": "translated",
            "value": "Wo Sie aufgehört haben, wird auch nach einer Umbenennung oder Verschiebung wiedergefunden, und Ihr Kavita-Server erfährt davon."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where you stopped is found again after a file is renamed or moved, and your Kavita server is told."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Donde lo dejó se vuelve a encontrar aunque el archivo cambie de nombre o de sitio, y su servidor Kavita se entera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’endroit où vous vous êtes arrêté est retrouvé même après un fichier renommé ou déplacé, et votre serveur Kavita en est informé."
          }
        }
      }
    },
    "whatsnew.0-1-0.place.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Stelle bleibt erhalten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your place is kept"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su punto de lectura se conserva"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre page est retenue"
          }
        }
      }
    },
    "whatsnew.0-1-0.private.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Konto, keine Analyse. StoryArc spricht nur mit den Bibliotheken, die Sie selbst hinzugefügt haben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No account, no analytics. StoryArc talks only to the libraries you added yourself."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin cuenta y sin analíticas. StoryArc solo habla con las bibliotecas que usted añadió."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de compte, pas de statistiques. StoryArc ne parle qu’aux bibliothèques que vous avez ajoutées."
          }
        }
      }
    },
    "whatsnew.0-1-0.private.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts verlässt das Gerät"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing leaves the device"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada sale del dispositivo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien ne quitte l’appareil"
          }
        }
      }
    },
    "whatsnew.0-1-0.reading.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fünf Schriften, sechs Lesethemen und eine Seite, die sich wie Papier umblättert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Five typefaces, six reading themes, and a page that turns like paper."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cinco tipografías, seis temas de lectura y una página que se pasa como el papel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cinq polices, six thèmes de lecture, et une page qui se tourne comme du papier."
          }
        }
      }
    },
    "whatsnew.0-1-0.reading.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Lesen gemacht"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Made to be read"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hecho para leerse"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fait pour être lu"
          }
        }
      }
    },
    "whatsnew.0-1-0.sources.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordner auf diesem Gerät, OPDS-Kataloge, Kavita-Server und Netzwerkfreigaben, in einem Regal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Folders on this device, OPDS catalogues, Kavita servers and network shares, all on one shelf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Carpetas de este dispositivo, catálogos OPDS, servidores Kavita y recursos compartidos en red, en un solo estante."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les dossiers de cet appareil, les catalogues OPDS, les serveurs Kavita et les partages réseau, sur une seule étagère."
          }
        }
      }
    },
