    "about.acknowledgements": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Danksagungen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Acknowledgements"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agradecimientos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remerciements"
          }
        }
      }
    },
    "about.acknowledgements.note": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles, was StoryArc mitliefert und andere geschrieben haben. Tippen Sie auf einen Eintrag für die vollständige Lizenz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything StoryArc ships that someone else wrote. Tap one for its licence in full."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo lo que StoryArc incluye y que escribieron otros. Toque uno para ver su licencia completa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout ce que StoryArc embarque et qui a été écrit par d’autres. Touchez un élément pour lire sa licence en entier."
          }
        }
      }
    },
