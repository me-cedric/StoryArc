    "appIcon.note": {
      "comment": "Android says its launcher draws the new icon the next time it draws its list. Each platform states what its own system does after an icon change. The difference is deliberate, and `localization` / One state, one name calls a platform's own behaviour no divergence.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fünf Gesichter einer Marke. iOS zeigt seine eigene Bestätigung, wenn sich das Symbol ändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Five faces of one mark. iOS shows its own confirmation when the icon changes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cinco caras de una misma marca. iOS muestra su propia confirmación cuando cambia el icono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cinq visages d’une même marque. iOS affiche sa propre confirmation lorsque l’icône change."
          }
        }
      }
    },
