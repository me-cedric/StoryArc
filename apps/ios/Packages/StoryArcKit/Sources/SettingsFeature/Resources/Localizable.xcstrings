    "downloads.remove.action %@": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Download von %@ entfernen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove the download of %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminar la descarga de %@"
          }
        },
        "fr": {
