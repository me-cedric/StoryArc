    "reading.defaults.fixed": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Comics und Bilderbücher"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Comics and picture books"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cómics y libros ilustrados"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "BD et livres illustrés"
          }
        }
      }
    },
    "reading.defaults.note": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gilt für Serien, die Sie noch nicht geöffnet haben. Ein beim Lesen gewähltes Thema bleibt bei dieser Serie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applies to series you have not opened before. A theme you set while reading stays with that series."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se aplica a series que no ha abierto antes. Un tema elegido al leer se queda con esa serie."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S’applique aux séries jamais ouvertes. Un thème choisi pendant la lecture reste attaché à cette série."
          }
        }
      }
    },
    "reading.defaults.reflowable": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bücher"
