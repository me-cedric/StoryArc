    "sources.remove.footer": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Entfernen einer Bibliothek wird gelöscht, was Sie daraus heruntergeladen haben, und Ihre Lesepositionen bleiben 30 Tage erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removing a library deletes what you downloaded from it and keeps your reading positions for 30 days."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quitar una biblioteca borra lo que descargaste de ella y conserva tus posiciones de lectura durante 30 días."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retirer une bibliothèque supprime ce que vous en avez téléchargé et conserve vos positions de lecture pendant 30 jours."
          }
        }
      }
    },
    "sources.remove.title %@": {
      "comment": "one-vocabulary 4.1/15.11, D31: Android's confirmation titles name the source (sources_remove_title, sources_remove_downloads_title); iOS's do not. Reconciling would change a convention on both keys and an iOS Swift signature, which is a code change rather than a wording one -- left as each platform's own convention.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ entfernen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove %@?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Quitar %@?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retirer %@ ?"
          }
        }
      }
    },
    "sources.removeDownloads.body %@": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das löscht %@ an Dateien, die aus dieser Bibliothek geladen wurden. Die Bibliothek bleibt, und Ihre Lesepositionen ebenfalls."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This deletes %@ of files downloaded from this library. The library stays, and so do your reading positions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto borra %@ de archivos descargados de esta biblioteca. La biblioteca se queda, y tus posiciones de lectura también."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime %@ de fichiers téléchargés depuis cette bibliothèque. La bibliothèque reste, ainsi que vos positions de lecture."
          }
        }
      }
    },
    "sources.removeDownloads.title": {
      "comment": "one-vocabulary 4.1/15.11, D31: Android names the source here too (sources_remove_downloads_title) and iOS does not, the same divergence as sources.remove.title beside it. Reconciling changes a convention on both keys and an iOS Swift signature.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloads entfernen?"
