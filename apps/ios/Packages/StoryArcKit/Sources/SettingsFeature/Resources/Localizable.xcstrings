    "downloads.remove.body %@": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies löscht die Kopie von %@ auf diesem Gerät. Ihre Leseposition bleibt erhalten, und der Katalog kann sie erneut liefern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This deletes the copy of %@ on this device. Your reading position is kept, and the catalogue can be asked for it again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina la copia de %@ en este dispositivo. Se conserva su posición de lectura y el catálogo puede volver a facilitarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime la copie de %@ sur cet appareil. Votre position de lecture est conservée et le catalogue peut la redonner."
          }
        }
      }
    },
    "downloads.remove.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diesen Download entfernen?"
          }
