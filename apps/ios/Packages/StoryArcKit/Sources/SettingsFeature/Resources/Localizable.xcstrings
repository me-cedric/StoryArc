    "covers.lookup": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fehlende Cover nachschlagen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Look up missing covers"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Buscar portadas que faltan"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechercher les couvertures manquantes"
          }
        }
      }
    },
    "covers.lookup.note": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus, bis Sie es einschalten. StoryArc fragt dann nur die oben genannten Dienste. Für eine Publikation ohne Cover sendet es eine einzige Kennung — eine ISBN, eine MusicBrainz-Kennung oder eine ASIN. Wenn Sie nach Titel suchen, sendet es den Titel und den Autor. Sonst nichts: keine Bibliotheksliste, kein Leseverlauf, keine Gerätekennung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off until you turn it on. StoryArc then asks only the services named above. For a publication with no cover, it sends one identifier — an ISBN, a MusicBrainz id or an ASIN. When you search by title, it sends the title and the author. Nothing else: no library listing, no reading history, no device identifier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado hasta que lo active. StoryArc consulta entonces solo los servicios nombrados arriba. Para una publicación sin portada, envía un solo identificador — un ISBN, un identificador MusicBrainz o un ASIN. Cuando busca por título, envía el título y el autor. Nada más: ninguna lista de biblioteca, ningún historial de lectura, ningún identificador de dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé tant que vous ne l’activez pas. StoryArc n’interroge alors que les services nommés ci-dessus. Pour une publication sans couverture, il envoie un seul identifiant — un ISBN, un identifiant MusicBrainz ou un ASIN. Quand vous cherchez par titre, il envoie le titre et l’auteur. Rien d’autre : aucune liste de bibliothèque, aucun historique de lecture, aucun identifiant d’appareil."
          }
        }
      }
    },
    "covers.lookup.providers %@": {
      "extractionState": "manual",
      "localizations": {
        "de": {
