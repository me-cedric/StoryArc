    "privacy.downloads.note": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem Gerät behalten, damit sie ohne Netz öffnen. Löschen entfernt die Dateien, nicht das Gelesene."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kept on this device so they open without a network. Clearing removes the files, not what you have read."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se guardan en este dispositivo para abrirse sin red. Borrar quita los archivos, no lo que has leído."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conservés sur cet appareil pour s’ouvrir sans réseau. Effacer supprime les fichiers, pas ce que vous avez lu."
          }
        }
      }
    },
    "privacy.history %@": {
