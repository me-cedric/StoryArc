    "privacy.diagnostic.note": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was die App über sich selbst weiß. Servernamen, Pfade und Zugangsdaten werden vor der Anzeige entfernt, und es wird nichts gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What the app knows about itself. Server names, paths and credentials are removed before it is shown, and nothing is sent anywhere."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que la app sabe de sí misma. Los nombres de servidor, las rutas y las credenciales se quitan antes de mostrarlo, y no se envía nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que l’application sait d’elle-même. Les noms de serveurs, les chemins et les identifiants sont retirés avant l’affichage, et rien n’est envoyé."
          }
        }
      }
    },
