    "privacy.history.note": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Stelle, an der Sie in allem Geöffneten aufgehört haben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where you stopped in everything you have opened."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dónde lo dejaste en todo lo que has abierto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’endroit où vous vous êtes arrêté dans tout ce que vous avez ouvert."
          }
        }
      }
    },
    "privacy.sources": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Daten verlassen dieses Gerät nur zu den Bibliotheken, die Sie selbst eingerichtet haben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Data leaves this device only to the libraries you set up yourself."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los datos solo salen de este dispositivo hacia las bibliotecas que tú mismo configuraste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données ne quittent cet appareil que vers les bibliothèques que vous avez ajoutées vous-même."
          }
        }
      }
    },
    "privacy.statement": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "StoryArc hat kein Konto, kein Backend, keine Analyse und keine Absturzberichte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "StoryArc has no account, no backend, no analytics and no crash reporting."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "StoryArc no tiene cuenta, ni backend, ni analítica, ni informes de errores."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "StoryArc n’a aucun compte, aucun serveur, aucune analyse et aucun rapport de plantage."
          }
        }
      }
    },
