    "appearance.linkTheme": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lesethema an die App anpassen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Match the reading theme to the app"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Igualar el tema de lectura a la app"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accorder le thème de lecture à l’application"
          }
        }
      }
    },
    "appearance.linkTheme.note": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardmäßig aus. Eine dunkle App mit einer papierweißen Seite ist eine legitime Vorliebe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off by default. A dark app with a paper-white page is a legitimate preference."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado por defecto. Una app oscura con una página blanca es una preferencia legítima."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé par défaut. Une application sombre avec une page blanche est une préférence légitime."
          }
        }
      }
    },
    "appearance.oledDark": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OLED-Dunkel"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OLED Dark"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Oscuro OLED"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sombre OLED"
          }
        }
      }
    },
    "appearance.oledDark.note": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bedienoberfläche in echtem Schwarz. Die Seite bleibt knapp darüber, weil reines Schwarz auf OLED beim Seitenwechsel schmiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "True black chrome. The page itself stays just above black, because pure black smears on OLED during a page turn."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Interfaz en negro absoluto. La página se mantiene apenas por encima del negro, porque el negro puro se difumina en OLED al cambiar de página."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Interface en noir absolu. La page reste juste au-dessus du noir : le noir pur bave sur OLED pendant une tourne de page."
          }
        }
      }
    },
    "appearance.system": {
      "extractionState": "manual",
      "localizations": {
