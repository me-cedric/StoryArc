    "transfer.done.conflict.many %lld": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Beide Geräte waren bei %lld Titel weitergekommen. Die weitere Position wurde behalten."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Beide Geräte waren bei %lld Titeln weitergekommen. Für jeden wurde die weitere Position behalten."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Both devices had moved on in %lld title. The further position was kept."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Both devices had moved on in %lld titles. The further position was kept for each."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Ambos dispositivos habían avanzado en %lld título. Se conservó la posición más avanzada."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Ambos dispositivos habían avanzado en %lld títulos. Se conservó la posición más avanzada de cada uno."
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Les deux appareils avaient avancé dans %lld titre. La position la plus avancée a été conservée."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Les deux appareils avaient avancé dans %lld titres. La position la plus avancée a été conservée pour chacun."
                }
              }
            }
          }
        }
      }
    },
    "transfer.done.conflict.one %@ %@": {
