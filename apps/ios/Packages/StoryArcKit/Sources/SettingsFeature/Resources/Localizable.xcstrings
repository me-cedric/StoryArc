    "privacy.clear.downloads": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloads löschen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear downloads"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Borrar descargas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Effacer les téléchargements"
          }
        }
      }
    },
    "privacy.clear.downloads.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede heruntergeladene Publikation wird von diesem Gerät entfernt. Ihre Quellen, Ihr Lesefortschritt und Ihre Sammlungen bleiben unberührt; was noch auf einer Quelle liegt, lässt sich erneut herunterladen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every downloaded publication is removed from this device. Your sources, your reading progress and your collections are not affected, and anything still on a source can be downloaded again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se elimina de este dispositivo cada publicación descargada. Tus fuentes, tu progreso de lectura y tus colecciones no se ven afectados, y lo que siga en una fuente se puede volver a descargar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque publication téléchargée est retirée de cet appareil. Vos sources, votre progression de lecture et vos collections ne sont pas touchées, et ce qui reste sur une source peut être téléchargé de nouveau."
          }
        }
      }
    },
    "privacy.clear.history": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leseverlauf löschen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear reading history"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Borrar el historial de lectura"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Effacer l’historique de lecture"
          }
        }
      }
    },
    "privacy.clear.history.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Publikation beginnt wieder auf der ersten Seite. Ihre Dateien, Quellen und Einstellungen bleiben unberührt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every publication goes back to its first page. Your files, sources and settings are not affected."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada publicación vuelve a su primera página. Sus archivos, fuentes y ajustes no se ven afectados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque publication revient à sa première page. Vos fichiers, sources et réglages ne sont pas touchés."
