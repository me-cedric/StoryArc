      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vollständig kostenlos und Open Source. Keine Bezahlstufe, keine Werbung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Completely free and open source. No paid tier, no advertising."
          }
        },
        "es": {
