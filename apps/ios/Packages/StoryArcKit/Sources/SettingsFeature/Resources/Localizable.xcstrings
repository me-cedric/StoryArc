    "about.free": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vollständig kostenlos und Open Source. Keine Bezahlstufe, keine Werbung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Completely free and open source. No paid tier, no advertising."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Completamente gratuito y de código abierto. Sin nivel de pago ni publicidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Entièrement gratuit et open source. Aucune offre payante, aucune publicité."
