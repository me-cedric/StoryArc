    "privacy.clear.downloads": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloads löschen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear downloads"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Borrar descargas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Effacer les téléchargements"
          }
        }
      }
    },
    "privacy.clear.downloads.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles Heruntergeladene wird von diesem Gerät entfernt. Ihre Bibliotheken, Ihr Lesefortschritt und Ihre Sammlungen bleiben unberührt, und alles, was noch in einer Bibliothek liegt, lässt sich erneut herunterladen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything downloaded is removed from this device. Your libraries, your reading progress and your collections are not affected, and anything still in a library can be downloaded again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se quita de este dispositivo todo lo descargado. Tus bibliotecas, tu progreso de lectura y tus colecciones no se ven afectados, y lo que siga en una biblioteca se puede descargar otra vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout ce qui a été téléchargé est retiré de cet appareil. Vos bibliothèques, votre progression de lecture et vos collections ne sont pas touchées, et ce qui reste dans une bibliothèque peut être téléchargé à nouveau."
          }
        }
      }
    },
    "privacy.clear.history": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leseverlauf löschen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear reading history"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Borrar el historial de lectura"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Effacer l’historique de lecture"
          }
        }
      }
    },
    "privacy.clear.history.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Buch und jeder Comic springt zurück auf die erste Seite. Ihre Dateien, Ihre Bibliotheken und Ihre Einstellungen bleiben unberührt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every book and comic goes back to its first page. Your files, your libraries and your settings are not affected."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada libro y cada cómic vuelve a su primera página. Tus archivos, tus bibliotecas y tus ajustes no se ven afectados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque livre et chaque bande dessinée revient à sa première page. Vos fichiers, vos bibliothèques et vos réglages ne sont pas touchés."
          }
        }
      }
    },
    "privacy.clear.history.serverNote": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Fortschritt auf einem Server, von dem Sie lesen, wird dadurch nicht geändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Progress kept on a server you read from is not changed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El progreso guardado en un servidor del que lees no cambia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La progression conservée sur un serveur depuis lequel vous lisez n’est pas modifiée."
          }
        }
      }
    },
