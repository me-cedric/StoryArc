    "smb.error.authentication": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benutzername oder Passwort wurde abgelehnt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The user name or password was refused."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se rechazó el nombre de usuario o la contraseña."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nom d’utilisateur ou le mot de passe a été refusé."
          }
        }
      }
    },
    "smb.error.encryption": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Server verlangt SMB-3-Verschlüsselung, die StoryArc noch nicht beherrscht. Stellen Sie die Verschlüsselung auf dem Server auf „aktiviert“ statt „erforderlich“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This server requires SMB 3 encryption, which StoryArc cannot do yet. Set encryption on the server to enabled rather than required."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este servidor requiere cifrado SMB 3, que StoryArc aún no admite. Configura el cifrado del servidor como activado en lugar de obligatorio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce serveur exige le chiffrement SMB 3, que StoryArc ne sait pas encore faire. Réglez le chiffrement du serveur sur activé plutôt qu’obligatoire."
          }
        }
      }
    },
    "smb.error.hostUnreachable": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Host hat nicht geantwortet. Prüfen Sie den Namen und ob das Gerät im selben Netzwerk ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That host did not answer. Check the name and that the device is on the same network."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese host no respondió. Comprueba el nombre y que el dispositivo esté en la misma red."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet hôte n’a pas répondu. Vérifiez le nom et que l’appareil est sur le même réseau."
          }
        }
      }
    },
    "smb.error.keyNotStored": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät hat das Passwort nicht gespeichert, daher wurde die Freigabe nicht hinzugefügt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device would not store the password, so the share was not saved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo no guardó la contraseña, así que el recurso no se añadió."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil n’a pas enregistré le mot de passe, le partage n’a donc pas été ajouté."
          }
        }
      }
    },
    "smb.error.notAnAddress": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geben Sie einen Host und einen Freigabenamen ein."
          }
        },
        "en": {
          "stringUnit": {
