    "library.restart.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Stelle hier wird vergessen, und es öffnet sich beim nächsten Mal auf Seite eins. Sonst ändert sich nichts, und die Datei selbst bleibt unberührt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your place here is forgotten, and it opens at page one next time. Nothing else changes, and the file itself is untouched."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se olvida tu punto de lectura aquí, y la próxima vez se abrirá en la primera página. Nada más cambia, y el archivo no se toca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre position ici est oubliée, et la lecture reprendra à la première page. Rien d’autre ne change, et le fichier lui-même n’est pas touché."
          }
        }
      }
    },
