    "shelves.unpin": {
      "comment": "The same control on a shelf that is already pinned. Removes the shelf from the home surface and alters neither the collection nor the list.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von Start lösen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unpin from Home"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No fijar en Inicio"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne plus épingler"
          }
        }
      }
    },
    "sidebar.allShelves": {
      "comment": "iPad sidebar: the row that leads to every shelf, including the ones the sidebar could not list.",
