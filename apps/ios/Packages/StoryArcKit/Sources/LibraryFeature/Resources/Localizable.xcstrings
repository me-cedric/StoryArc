    "source.unauthorized.body %@": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät hat den Schlüssel für %@ nicht mehr. Entfernen Sie die Quelle in den Einstellungen und fügen Sie sie erneut hinzu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device no longer holds the key for %@. Remove the source in Settings and add it again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo ya no guarda la clave de %@. Elimina la fuente en Ajustes y vuelve a añadirla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil ne conserve plus la clé de %@. Supprimez la source dans les réglages, puis ajoutez-la de nouveau."
          }
        }
      }
    },
