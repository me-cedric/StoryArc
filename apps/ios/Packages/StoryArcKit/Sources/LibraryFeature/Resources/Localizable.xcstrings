    "source.unauthorized.body %@": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "StoryArc hat die Anmeldung für %@ verloren. Öffnen Sie sie in den Einstellungen und melden Sie sich erneut an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "StoryArc has lost its sign-in for %@. Open it in Settings and sign in again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "StoryArc ha perdido el inicio de sesión de %@. Ábrela en Ajustes e inicia sesión de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "StoryArc a perdu la connexion à %@. Ouvrez-la dans Réglages et reconnectez-vous."
          }
        }
      }
    },
    "source.unauthorized.refused.body %@": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat die gespeicherte Anmeldung abgelehnt. Öffnen Sie sie in den Einstellungen und melden Sie sich erneut an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ refused the sign-in StoryArc had. Open it in Settings and sign in again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ rechazó el inicio de sesión guardado. Ábrela en Ajustes e inicia sesión de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a refusé la connexion enregistrée par StoryArc. Ouvrez-la dans Réglages et reconnectez-vous."
          }
        }
      }
    },
