    "shelves.promote.why %@": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat sie nicht, und StoryArc lädt niemals eine Datei hoch. Sie bleiben in der Liste auf diesem Gerät."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ does not hold them, and StoryArc never uploads a file. They stay in the list on this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no las tiene, y StoryArc nunca sube ningún archivo. Se quedan en la lista de este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ne les possède pas, et StoryArc n’envoie jamais de fichier. Elles restent dans la liste sur cet appareil."
          }
        }
      }
    },
