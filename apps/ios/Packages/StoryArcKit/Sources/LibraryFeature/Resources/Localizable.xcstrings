    },
    "smb.cannotOpen": {
      "comment": "Shown in the share browser when a publication that has just been fetched turns out to be one no decoder will open — a solid RAR4. The transfer changed nothing, and the sentence says so rather than sending the reader to a reader that cannot render page one.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "StoryArc kann diese Datei nicht öffnen, hier so wenig wie irgendwo sonst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "StoryArc cannot open this file, here or anywhere else."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "StoryArc no puede abrir este archivo, ni aquí ni en ningún otro sitio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "StoryArc ne peut pas ouvrir ce fichier, ni ici ni ailleurs."
          }
        }
      }
    },
    "smb.connect": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se connecter"
          }
        }
      }
    },
    "smb.downloadFirst.body %@ %@": {
      "comment": "The share browser, before a publication whose decoder needs a file on the device is transferred. First the publication's name, then its size as the share stated it.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@“ lässt sich nicht direkt von der Freigabe öffnen: dieses Format braucht eine Datei auf dem Gerät. Sie ist %2$@ groß."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” cannot be opened straight from the share: this format needs a file on the device. It is %2$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» no se puede abrir directamente desde el recurso compartido: este formato necesita un archivo en el dispositivo. Ocupa %2$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %1$@ » ne peut pas s’ouvrir directement depuis le partage : ce format exige un fichier sur l’appareil. Il pèse %2$@."
          }
        }
      }
    },
    "smb.downloadFirst.bodyUnstated %@": {
      "comment": "The same offer as `smb.downloadFirst.body`, for the entry whose length the share did not state. `offline-downloads` requires an unknown size to be an absence rather than a zero.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ lässt sich nicht direkt von der Freigabe öffnen: dieses Format braucht eine Datei auf dem Gerät. Die Freigabe nennt keine Dateigröße."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” cannot be opened straight from the share: this format needs a file on the device. The share does not state its size."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» no se puede abrir directamente desde el recurso compartido: este formato necesita un archivo en el dispositivo. El recurso no indica su tamaño."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » ne peut pas s’ouvrir directement depuis le partage : ce format exige un fichier sur l’appareil. Le partage n’indique pas sa taille."
          }
        }
      }
    },
    "smb.downloadFirst.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zuerst herunterladen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download it first?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Descargarla primero?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La télécharger d’abord ?"
          }
        }
      }
    },
