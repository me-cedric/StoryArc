    "catalogue.error.offline": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät ist mit keinem Netzwerk verbunden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device is not connected to a network."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
