    "catalogue.untrusted.explanation": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder im Netzwerk zwischen Ihnen und diesem Server könnte mitlesen, was Sie senden. Fügen Sie ihn nur hinzu, wenn der Fingerabdruck unten mit dem übereinstimmt, den Ihr Server ausgegeben hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anyone on the network between you and this server could be reading what you send. Add it only if the fingerprint below matches the one your server printed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cualquiera en la red entre usted y este servidor podría leer lo que envía. Añádalo solo si la huella de abajo coincide con la que imprimió su servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "N’importe qui sur le réseau entre vous et ce serveur pourrait lire ce que vous envoyez. Ne l’ajoutez que si l’empreinte ci-dessous correspond à celle affichée par votre serveur."
          }
        }
      }
    },
    "catalogue.untrusted.fingerprint": {
