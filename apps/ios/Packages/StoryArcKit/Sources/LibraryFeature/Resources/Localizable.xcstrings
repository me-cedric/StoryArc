    "smb.error.shareNotFound": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Freigabe gibt es auf diesem Host nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That share is not on this host."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese recurso no está en este host."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce partage n’existe pas sur cet hôte."
          }
        }
      }
    },
    "smb.error.smb1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Server bietet nur SMB 1 an, das aus Sicherheitsgründen deaktiviert ist. Aktivieren Sie SMB 2 oder neuer auf dem Server — bei den meisten NAS-Geräten unter Dateidienste, SMB."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This server only offers SMB 1, which is disabled for security reasons. Enable SMB 2 or later on the server — on most NAS boxes that is under File Services, SMB."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este servidor solo ofrece SMB 1, que está desactivado por seguridad. Activa SMB 2 o posterior en el servidor — en la mayoría de los NAS está en Servicios de archivos, SMB."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce serveur ne propose que SMB 1, désactivé pour des raisons de sécurité. Activez SMB 2 ou une version ultérieure sur le serveur — sur la plupart des NAS, dans Services de fichiers, SMB."
          }
        }
      }
    },
    "smb.error.unexpected": {
