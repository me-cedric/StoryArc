    "smb.metered.body %@": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Verbindung ist kostenpflichtig oder der Datensparmodus ist an. „%@“ zu lesen verbraucht Daten von der Freigabe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This connection is metered or data saver is on. Reading “%@” will use data from the share."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta conexión está medida o el ahorro de datos está activado. Leer «%@» consumirá datos del recurso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette connexion est limitée ou l’économiseur de données est actif. Lire « %@ » consommera des données du partage."
          }
        }
      }
    },
