          }
        }
      }
    },
    "catalogue.error.notAURL": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist keine Adresse, die StoryArc erreichen kann."
