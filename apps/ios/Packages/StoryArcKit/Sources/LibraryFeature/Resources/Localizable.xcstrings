    "library.empty.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing here yet"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien pour l’instant"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch nichts hier"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí no hay nada aún"
          }
        }
      }
    },
    "library.empty.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a source, or just open a file — StoryArc works without any setup."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez une source, ou ouvrez simplement un fichier — StoryArc fonctionne sans configuration."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügen Sie eine Quelle hinzu oder öffnen Sie einfach eine Datei – StoryArc funktioniert ohne Einrichtung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade una fuente o simplemente abre un archivo: StoryArc funciona sin configuración."
          }
        }
      }
    },
    "source.kind.localFolder.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Files and folders"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fichiers et dossiers"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateien und Ordner"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivos y carpetas"
          }
        }
      }
    },
    "source.kind.localFolder.explanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On this device, iCloud Drive, or any Files provider"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur cet appareil, iCloud Drive ou tout fournisseur Fichiers"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem Gerät, in iCloud Drive oder bei jedem Dateianbieter"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En este dispositivo, iCloud Drive o cualquier proveedor de Archivos"
          }
        }
      }
    },
    "source.kind.networkShare.title": {
