    "catalogue.error.refusedAddress": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Katalog verweist auf eine Adresse, der StoryArc nicht folgt – entweder keine Web-Adresse oder eine unverschlüsselte HTTP-Adresse von einem Server, den du sicher erreichst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This catalogue pointed somewhere StoryArc will not follow — an address that is not a web address, or a plain-HTTP one from a server you reach securely."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este catálogo apuntó a una dirección que StoryArc no seguirá: una dirección que no es web, o una de HTTP sin cifrar desde un servidor al que llegas de forma segura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce catalogue a désigné une adresse que StoryArc ne suivra pas : une adresse qui n’est pas une adresse web, ou une adresse en HTTP simple alors que ce serveur est joint de façon sécurisée."
          }
        }
      }
    },
    "catalogue.error.secretNotStored": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät wollte die Anmeldung nicht speichern, daher wurde der Katalog nicht hinzugefügt. Es wurde nichts halbfertig gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device would not store the sign-in, so the catalogue was not added. Nothing was saved half-finished."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo no quiso guardar el inicio de sesión, así que no se añadió el catálogo. No se guardó nada a medias."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil n’a pas voulu conserver l’identification : le catalogue n’a pas été ajouté. Rien n’a été enregistré à moitié."
          }
        }
      }
    },
