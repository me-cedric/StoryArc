    "source.kind.opdsCatalog.explanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Any server that speaks OPDS, such as Calibre-Web or Komga"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout serveur compatible OPDS, comme Calibre-Web ou Komga"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Server, der OPDS spricht, etwa Calibre-Web oder Komga"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cualquier servidor que hable OPDS, como Calibre-Web o Komga"
          }
        }
      }
    },
