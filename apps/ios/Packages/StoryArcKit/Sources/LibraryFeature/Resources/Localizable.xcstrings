    "source.offline.body %@": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist nicht erreichbar, deshalb lässt sich der Inhalt nicht auflisten. Alles, was Sie bereits daraus geladen haben, bleibt in Ihrer Bibliothek und bleibt lesbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ cannot be reached, so what it holds cannot be listed. Anything you have already downloaded from it stays in your library and stays readable."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede acceder a %@, así que no se puede listar lo que contiene. Lo que ya hayas descargado de ahí sigue en tu biblioteca y se puede leer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est injoignable, donc son contenu ne peut pas être listé. Ce que vous en avez déjà téléchargé reste dans votre bibliothèque et reste lisible."
          }
        }
      }
    },
