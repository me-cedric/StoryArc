      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quitar"
          }
        },
        "fr": {
          "stringUnit": {
