    "sync.conflict.body %lld": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Titel wurden sowohl auf diesem Gerät als auch in der Herkunftsbibliothek weitergelesen. Die weiteste Position wurde behalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld titles moved on both this device and the library they came from. The furthest position was kept."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld títulos avanzaron tanto en este dispositivo como en la biblioteca de origen. Se conservó la posición más avanzada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld titres ont avancé à la fois sur cet appareil et dans la bibliothèque d’origine. La position la plus avancée a été conservée."
          }
        }
      }
    },
