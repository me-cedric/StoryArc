    "kavita.error.keyNotStored": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät wollte den API-Schlüssel nicht speichern, daher wurde der Server nicht hinzugefügt. Es wurde nichts halbfertig gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device would not store the API key, so the server was not added. Nothing was saved half-finished."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo no quiso guardar la clave de API, así que no se añadió el servidor. No se guardó nada a medias."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil n’a pas voulu conserver la clé d’API : le serveur n’a pas été ajouté. Rien n’a été enregistré à moitié."
          }
        }
      }
    },
    "kavita.error.keyRejected": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser API-Schlüssel wurde abgelehnt. Prüfen Sie ihn in Ihren Kavita-Kontoeinstellungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That API key was refused. Check it in your Kavita account settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se rechazó esa clave de API. Compruébela en los ajustes de su cuenta de Kavita."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette clé d’API a été refusée. Vérifiez-la dans les réglages de votre compte Kavita."
          }
        }
      }
    },
