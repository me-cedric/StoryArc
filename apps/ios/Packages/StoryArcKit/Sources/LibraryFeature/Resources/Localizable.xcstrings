    "catalogue.error.secretNotStored": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät wollte die Anmeldung nicht speichern, daher wurde der Katalog nicht hinzugefügt. Es wurde nichts halbfertig gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device would not store the sign-in, so the catalogue was not added. Nothing was saved half-finished."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo no quiso guardar el inicio de sesión, así que no se añadió el catálogo. No se guardó nada a medias."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil n’a pas voulu conserver l’identification : le catalogue n’a pas été ajouté. Rien n’a été enregistré à moitié."
          }
        }
      }
    },
    "catalogue.error.timedOut": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat nicht rechtzeitig geantwortet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server did not answer in time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor no respondió a tiempo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur n’a pas répondu à temps."
          }
        }
      }
    },
    "catalogue.error.unauthorized": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Katalog hat die angegebene Anmeldung abgelehnt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This catalogue refused the sign-in it was given."
          }
        },
