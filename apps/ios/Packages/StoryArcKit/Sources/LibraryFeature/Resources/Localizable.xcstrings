    "catalogue.error.changedCertificate": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Zertifikat für %@ hat sich geändert, seit Sie ihm vertraut haben. Entfernen Sie diese Quelle und fügen Sie sie nur wieder hinzu, wenn Sie den Grund kennen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The certificate for %@ has changed since you trusted it. Remove this source and add it again only if you know why."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El certificado de %@ ha cambiado desde que confió en él. Elimine esta fuente y vuelva a añadirla solo si sabe por qué."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le certificat de %@ a changé depuis que vous l’avez approuvé. Supprimez cette source et ajoutez-la de nouveau seulement si vous savez pourquoi."
          }
        }
      }
    },
    "catalogue.error.empty": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat gar nichts zurückgegeben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server answered with nothing at all."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor no devolvió nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur n’a rien renvoyé."
          }
        }
      }
    },
    "catalogue.error.html": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Adresse hat eine Webseite zurückgegeben, keinen Katalog. Meist liegt das an einer Anmeldeseite oder einem falschen Pfad."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That address returned a web page, not a catalogue. A sign-in page or a wrong path usually does this."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esa dirección devolvió una página web, no un catálogo. Suele deberse a una página de inicio de sesión o a una ruta incorrecta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette adresse a renvoyé une page web, pas un catalogue. Une page d’identification ou un mauvais chemin en est souvent la cause."
          }
        }
      }
    },
    "catalogue.error.http": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat %1$d %2$@ geantwortet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server answered %1$d %2$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor respondió %1$d %2$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur a répondu %1$d %2$@."
          }
        }
      }
    },
    "catalogue.error.malformed": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Katalog konnte nicht gelesen werden: %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The catalogue could not be read: %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer el catálogo: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le catalogue n’a pas pu être lu : %@"
          }
        }
      }
    },
    "catalogue.error.noHost": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Host wurde nicht gefunden. Prüfen Sie die Adresse und ob Sie im selben Netzwerk sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That host could not be found. Check the address and that you are on the same network."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró ese servidor. Compruebe la dirección y que está en la misma red."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet hôte est introuvable. Vérifiez l’adresse et que vous êtes sur le même réseau."
          }
        }
      }
    },
    "catalogue.error.notAFeed": {
      "extractionState": "manual",
      "localizations": {
