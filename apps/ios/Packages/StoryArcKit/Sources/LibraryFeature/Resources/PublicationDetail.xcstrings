    "detail.download.working": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird auf dieses Gerät kopiert…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copying to this device…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiando a este dispositivo…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copie sur cet appareil…"
          }
        }
      }
    },
    "detail.empty": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie ein Cover, um zu sehen, was es ist und woher es kommt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a cover to see what it is and where it came from."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una portada para ver qué es y de dónde viene."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez une couverture pour voir ce que c’est et d’où cela vient."
          }
        }
      },
      "comment": "The second pane, before a publication has been chosen."
    },
    "detail.gone": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist nicht mehr in Ihrer Bibliothek."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That is no longer in your library."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eso ya no está en tu biblioteca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela n’est plus dans votre bibliothèque."
          }
        }
      },
      "comment": "Shown by the surface a reader is returned to when the page cannot open."
    },
