        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto no se puede abrir hasta que esté en este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’ouvrir ceci tant que ce n’est pas sur cet appareil."
