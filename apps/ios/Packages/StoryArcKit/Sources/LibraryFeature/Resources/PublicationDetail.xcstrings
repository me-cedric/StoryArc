        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "También en %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aussi dans %@"
          }
        }
      },
      "comment": "%@ is the name the reader gave the library it is also held in."
    },
