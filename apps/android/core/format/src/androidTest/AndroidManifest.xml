<?xml version="1.0" encoding="utf-8"?>
<!--
    A content provider that exists only for the tests.

    `UriSource` is the adapter between a content `Uri` and the ranged reads every
    reader is built on, and nothing about it can be exercised without a provider
    on the other end. `FileProvider` is the smallest real one — it hands back a
    genuine `ParcelFileDescriptor`, which is exactly what the Storage Access
    Framework does.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="app.storyarc.core.format.test"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/test_file_paths" />
        </provider>
        <!--
            A document tree, for the scanner's content-tree walk. `DocumentsProvider` refuses to
            attach unless it is exported, grants uri permissions and is guarded by
            MANAGE_DOCUMENTS; the test runs in the same process, so the guard never turns it away.
        -->
        <provider
            android:name="app.storyarc.core.format.TestTreeProvider"
            android:authorities="app.storyarc.core.format.testtree"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS" />
    </application>
</manifest>
