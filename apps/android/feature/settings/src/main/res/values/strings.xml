    <string name="appearance_oled_dark">OLED Dark</string>
    <string name="appearance_oled_dark_note">True black chrome. The page itself stays just above black, because pure black smears on OLED during a page turn.</string>
    <string name="appearance_natural">Natural</string>
    <string name="appearance_natural_note">Paper texture and warm accents. It has its own light and dark, so it follows the appearance above rather than replacing it.</string>
    <string name="appearance_natural_unavailable">Not available with OLED Dark: warm paper stock and true black are opposite asks, and true black is why you chose that appearance.</string>
    <string name="appearance_dynamic_colour">Take colours from the wallpaper</string>
    <string name="appearance_dynamic_colour_note">Turn it on to take the colours of your wallpaper. Covers keep their neutral ground either way.</string>
    <string name="appearance_dynamic_colour_oled_note">OLED Dark already uses StoryArc’s palette: a wallpaper tint over true black is neither.</string>
    <string name="appearance_dynamic_colour_natural_note">Natural brings its own warm accents: a wallpaper tint beside them would be two themes at once.</string>
    <string name="appearance_link_theme">Match the reading theme to the app</string>
    <string name="appearance_link_theme_note">Off by default. A dark app with a paper-white page is a legitimate preference.</string>
    <string name="appearance_link_theme_light">Light theme</string>
    <string name="appearance_link_theme_dark">Dark theme</string>
    <string name="reading_volume_buttons">Volume buttons turn pages</string>
    <string name="reading_volume_buttons_note">Off by default: while reading, the volume buttons would stop changing the volume.</string>
    <string name="reading_tap_zones">Tapping the page turns it</string>
    <string name="reading_tap_zones_note">On by default: tap the left or right third of the page to turn it, and the middle third to show the controls.</string>
    <string name="privacy_statement">StoryArc has no account, no backend, no analytics and no crash reporting.</string>
