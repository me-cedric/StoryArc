<?xml version="1.0" encoding="utf-8"?>
<!--
    The EPUB screen is an activity, declared by the module that owns it rather
    than by the app: nothing outside this module should have to know that
    reflowable rendering needs a Fragment host.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity
            android:name=".EpubReaderActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density|smallestScreenSize" />
    </application>
</manifest>
