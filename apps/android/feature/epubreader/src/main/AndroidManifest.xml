<?xml version="1.0" encoding="utf-8"?>
<!--
    The EPUB screen is an activity, declared by the module that owns it rather
    than by the app: nothing outside this module should have to know that
    reflowable rendering needs a Fragment host.

    Read-aloud declares no service of its own. The voice is a player behind
    `:core:playback`'s `PlaybackService`, which holds the one media session, the
    foreground service type and the notification permission (task 13.2).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The reader asks for it when the voice starts: from API 33 the media notification
         needs it. Refusing it does not stop the voice. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <activity
            android:name=".EpubReaderActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density|smallestScreenSize" />
    </application>
</manifest>
