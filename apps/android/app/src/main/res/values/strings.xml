<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">StoryArc</string>
    <string name="open_in_refused_title">Cannot open this file</string>
    <string name="open_in_unsupported">%1$s is a %2$s file, which StoryArc does not read. It reads CBZ, CBR, CBT, EPUB, PDF, M4B and other audiobooks.</string>
    <string name="open_in_unreadable">%1$s is not a file StoryArc recognises. It reads CBZ, CBR, CBT, EPUB, PDF, M4B and other audiobooks.</string>
    <!-- Deliberately offers nothing to fill in. `publication-formats`: the app "does not
         prompt for a key, an account or an activation code, and does not suggest a way
         around the protection". Saying there is nothing to enter is what stops a reader
         waiting for a field that is never coming. -->
    <string name="open_in_protected">%1$s is protected by its store\'s content protection, so StoryArc cannot open it. StoryArc does not remove content protection, so there is nothing to enter here.</string>
    <string name="open_in_password_protected">%1$s is protected by a password. StoryArc does not manage archive passwords, so there is nothing to enter here.</string>
    <string name="open_in_damaged">%1$s could not be read. It may be damaged.</string>
    <string name="open_in_solid_archive">%1$s uses solid compression, which StoryArc cannot open.</string>
    <string name="open_in_dismiss">OK</string>
    <!-- The name used when the provider offers no name and the Uri has no last segment.
         It is interpolated into the three sentences above, so it is written to read inside
         one: lower case where the language does not capitalise a common noun. Two of the
         three English sentences start with it, and a missing capital there costs less than
         a wrong capital in the middle of the French and the Spanish ones. -->
    <string name="open_in_unnamed">this file</string>

    <!-- The player. The intervals are in the strings because they are on the controls:
         `audio-playback` asks the interval to be "stated on the control itself", and 15 s
         back / 30 s forward is a **product decision** — media3's own defaults are 5 and 15.
         Formatted in rather than written out, because the same requirement asks for an
         interval "the listener can configure" and a label that said fifteen while the
         button moved ten would be worse than one that said nothing. -->
    <string name="player_play">Play</string>
    <string name="player_pause">Pause</string>
    <string name="player_open">Open the player</string>
    <!-- Plurals rather than strings, and lint is right to insist: the label states a
         number, and a language that inflects around that number has to be able to.
         one-vocabulary 4.1/15.11, D31: iOS's player.skip.back/forward interpolate an
         already-formatted interval ("%@ back"); these pluralise a raw second count instead,
         which is the composition this platform's own plural resources force. Not a value
         divergence; a reader hears the same words either way. -->
    <plurals name="player_skip_back">
        <item quantity="one">Back %1$d second</item>
        <item quantity="other">Back %1$d seconds</item>
    </plurals>
    <plurals name="player_skip_forward">
        <item quantity="one">Forward %1$d second</item>
        <item quantity="other">Forward %1$d seconds</item>
    </plurals>
    <!-- What a skip control says over a synthesised voice, which moves one sentence at a
         time rather than a number of seconds. The same words iOS states under
         player.skip.sentence.previous and player.skip.sentence.next. -->
    <string name="player_skip_back_sentence">Previous sentence</string>
    <string name="player_skip_forward_sentence">Next sentence</string>
    <string name="player_seconds">%1$d s</string>
    <string name="player_sleep">Sleep timer</string>
    <string name="player_sleep_in">Sleep in %1$s</string>
    <string name="player_sleep_off">Off</string>
    <string name="player_sleep_minutes">%1$d min</string>
    <string name="player_sleep_end_of_chapter">End of chapter</string>
    <string name="player_chapters">Chapters</string>
    <!-- The word a chapter with no name of its own is numbered with: "Chapter 4". -->
    <string name="player_chapter_word">Chapter</string>
    <string name="player_current_chapter">Playing</string>
    <!-- Beside a chapter the listener has passed. The player's own word, because two of the
         library's read-state translations say "read" and an audiobook is heard. -->
    <string name="player_chapter_finished">Finished</string>
    <!-- A chapter's length, then how much of it is left: "5:00 · 2:00 left". Only the
         chapter in progress states the second half. -->
    <string name="player_chapter_left">%1$s · %2$s left</string>
    <string name="player_speed">Speed %1$s</string>
    <string name="player_nothing_playing">Nothing is playing.</string>
    <string name="player_finished_next">Next: %1$s</string>
    <string name="player_back">Back to the book</string>
    <!-- Stated in the player's own controls, never as an interruption. -->
    <plurals name="player_skipped_parts">
        <item quantity="one">%1$d part could not be played</item>
        <item quantity="other">%1$d parts could not be played</item>
    </plurals>

    <!-- `native-experience` quick actions: the menu the launcher shows on a long press.
         A launcher draws the long label where there is room for it and the short one where
         there is not, so the short label names the act and the long label names the act
         and the book. iOS shows both at once, on two lines. -->
    <string name="shortcut_continue">Continue reading</string>
    <string name="shortcut_continue_named">Continue %1$s</string>
    <string name="shortcut_library">Library</string>
    <string name="shortcut_downloads">Downloads</string>

    <!-- The three destinations. Always labelled: Material caps a navigation bar at three
         to five precisely so every one of them can carry its name, and `native-experience`
         never lets an icon alone say what something is. -->
    <string name="destination_home">Home</string>
    <string name="destination_library">Library</string>
    <string name="destination_downloads">Downloads</string>
    <string name="destination_search">Search</string>
    <string name="destination_open_library">Go to your library</string>

    <!-- Sections, revealed by opening the rail on a wide window. The library's own top bar
         carries both on a narrow window and drops them on a wide one, so these are what
         stops a tablet reader reaching neither. -->
    <string name="destination_shelves">Shelves</string>
    <string name="destination_settings">Settings</string>

    <!-- The rail's menu button. The glyph is the whole control, so its name is the
         description a screen reader reads out, and it says what pressing it will do rather
         than what the rail currently is. -->
    <string name="rail_expand">Show more places</string>
    <string name="rail_collapse">Show fewer places</string>


    <string name="downloads_destination_on_device">On this device</string>
    <string name="downloads_destination_in_flight">Coming down now</string>
    <string name="downloads_destination_empty">Nothing is on this device yet. A book you open from an online library is kept here.</string>

    <!-- The downloads destination speaks the vocabulary the settings screen used to. Same
         words, same four languages; only the module they are drawn from changed. -->
    <string name="downloads_total">Space used by downloads</string>
    <!-- The cover cache's own size, in the storage view: distinct from the general Cache
         row in Settings, which also counts the web view's own data. iOS carries the same
         pair of keys. -->
    <string name="downloads_cache">Cover cache</string>
    <string name="downloads_largest">Largest on this device</string>
    <string name="downloads_stop">Stop</string>
    <string name="downloads_remove">Remove download</string>
    <string name="downloads_cancel">Cancel</string>
    <string name="downloads_remove_title">Remove this download?</string>
    <string name="downloads_remove_body">This deletes the copy of %1$s on this device. Your reading position is kept, and it can be downloaded again.</string>
    <string name="downloads_remove_body_imported">This deletes the copy of %1$s that StoryArc keeps, freeing %2$s. The original file elsewhere on your device is not touched.</string>
    <string name="downloads_remove_action">Remove the download of %1$s</string>

    <!-- Stopping a transfer and removing a copy are different promises, so they are
         different sentences. `DownloadQueueRemoval` chooses between them; iOS carries the
         same four keys. Nothing of an unfinished transfer is on the device, and a
         publication nobody has opened has no reading position, so neither half of the
         removal sentence above is true of one. -->
    <string name="downloads_stop_title">Stop this download?</string>
    <string name="downloads_stop_body">This stops the transfer of %1$s. Nothing of it is kept on this device, and it can be downloaded again.</string>
    <string name="downloads_stop_confirm">Stop download</string>
    <!-- A failed transfer has already stopped, so it is removed rather than stopped, and
         the sentence says what a reader gets back: nothing, because nothing arrived. -->
    <string name="downloads_remove_body_unfinished">Nothing of %1$s reached this device. It leaves the queue, and it can be downloaded again.</string>
    <!-- The app layer's own copy, for the reason the block above says: the queue row is
         drawn here, and `:feature:library`'s banner is a different screen. -->
    <string name="downloads_retry">Retry</string>
    <!-- Three attempts is the ceiling `offline-downloads` sets, so one of them is a
         real case and reads wrong as "1 attempts". -->
    <plurals name="downloads_failed">
        <item quantity="one">Failed after %2$d attempt: %1$s</item>
        <item quantity="other">Failed after %2$d attempts: %1$s</item>
    </plurals>
    <string name="downloads_paused_by_reader">Paused</string>
    <string name="downloads_paused_waiting_for_wifi">Waiting for Wi-Fi</string>
    <string name="downloads_paused_out_of_space">Not enough space on the device</string>
    <string name="downloads_attempt_resumed">Resumed</string>
    <string name="downloads_attempt_restarted">Restarted</string>
    <string name="downloads_move_earlier">Move \u201c%1$s\u201d earlier</string>
    <string name="downloads_move_later">Move \u201c%1$s\u201d later</string>
    <string name="downloads_undo">Undo</string>
    <string name="downloads_removed">\u201c%1$s\u201d removed from this device. Your place is kept.</string>
    <!-- The bar answers roughly how far; this line answers how much, the question a reader
         with little space free is actually asking. iOS carries the same pair of keys. -->
    <string name="downloads_progress">%1$d%% \u00b7 %2$s of %3$s</string>
    <string name="downloads_progress_unsized">%1$s so far</string>

    <!-- `offline-downloads`' second requirement asks for "per-item and global pause, resume,
         cancel" together; only the per-item stop and the global cancel existed. iOS carries
         the same keys. -->
    <string name="downloads_pause">Pause</string>
    <string name="downloads_resume">Resume</string>
    <string name="downloads_pause_all">Pause all</string>
    <string name="downloads_resume_all">Resume all</string>
    <string name="downloads_cancel_all">Cancel all</string>
    <string name="downloads_cancel_all_title">Stop every download?</string>
    <string name="downloads_cancel_all_body">This stops every transfer in progress. Nothing of them is kept on this device, and each can be downloaded again.</string>
</resources>
