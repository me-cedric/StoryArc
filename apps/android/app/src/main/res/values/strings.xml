<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">StoryArc</string>
    <string name="open_in_refused_title">Cannot open this file</string>
    <string name="open_in_unsupported">%1$s is a %2$s file, which StoryArc does not read. It reads CBZ, CBR, CBT, EPUB, PDF and audiobooks.</string>
    <string name="open_in_unreadable">%1$s is not a file StoryArc recognises. It reads CBZ, CBR, CBT, EPUB, PDF and audiobooks.</string>
    <!-- Deliberately offers nothing to fill in. `publication-formats`: the app "does not
         prompt for a key, an account or an activation code, and does not suggest a way
         around the protection". Saying there is nothing to enter is what stops a reader
         waiting for a field that is never coming. -->
    <string name="open_in_protected">%1$s is protected by its store\'s content protection, and StoryArc cannot open it. StoryArc does not remove content protection, so there is nothing to enter here.</string>
    <string name="open_in_dismiss">OK</string>

    <!-- The player. The intervals are in the strings because they are on the controls:
         `audio-playback` asks the interval to be "stated on the control itself", and 15 s
         back / 30 s forward is a **product decision** — media3's own defaults are 5 and 15.
         Formatted in rather than written out, because the same requirement asks for an
         interval "the listener can configure" and a label that said fifteen while the
         button moved ten would be worse than one that said nothing. -->
    <string name="player_play">Play</string>
    <string name="player_pause">Pause</string>
    <string name="player_open">Open the player</string>
    <string name="player_skip_back">Back %1$d seconds</string>
    <string name="player_skip_forward">Forward %1$d seconds</string>
    <string name="player_seconds">%1$d s</string>
    <!-- Where the interval is chosen. Two rows because the two directions are different
         numbers on purpose: back is shorter because the reason to skip back is "I missed
         that sentence" and the reason to skip forward is "I know this part". -->
    <string name="player_skip">Skip</string>
    <string name="player_skip_back_interval">Back</string>
    <string name="player_skip_forward_interval">Forward</string>
    <!-- What a chip in those two rows is called to a screen reader. Deliberately not the
         same words as the transport control above it: "10 s" read out of the row it sits in
         names no direction, and borrowing the button's own name would give a listener two
         controls announced identically, one of which moves the audio and one of which does
         not. -->
    <string name="player_skip_back_choice">Skip back %1$d seconds</string>
    <string name="player_skip_forward_choice">Skip forward %1$d seconds</string>
    <string name="player_sleep">Sleep timer</string>
    <string name="player_sleep_in">Sleep in %1$s</string>
    <string name="player_sleep_off">Off</string>
    <string name="player_sleep_minutes">%1$d min</string>
    <string name="player_sleep_end_of_chapter">End of chapter</string>
    <string name="player_chapters">Chapters</string>
    <!-- The word a chapter with no name of its own is numbered with: "Chapter 4". -->
    <string name="player_chapter_word">Chapter</string>
    <string name="player_current_chapter">Playing</string>
    <string name="player_speed">Speed %1$s</string>
    <string name="player_nothing_playing">Nothing is playing.</string>
    <string name="player_back">Go back</string>
    <!-- Stated in the player's own controls, never as an interruption. -->
    <plurals name="player_skipped_parts">
        <item quantity="one">%1$d part could not be played</item>
        <item quantity="other">%1$d parts could not be played</item>
    </plurals>

    <!-- `native-experience` quick actions: the menu the launcher shows on a long press.
         A launcher draws the long label where there is room for it and the short one where
         there is not, so the short label names the act and the long label names the act
         and the book. iOS shows both at once, on two lines. -->
    <string name="shortcut_continue">Continue reading</string>
    <string name="shortcut_continue_named">Continue %1$s</string>
    <string name="shortcut_library">Library</string>
    <string name="shortcut_downloads">Downloads</string>

    <!-- The three destinations. Always labelled: Material caps a navigation bar at three
         to five precisely so every one of them can carry its name, and `native-experience`
         never lets an icon alone say what something is. -->
    <string name="destination_home">Home</string>
    <string name="destination_library">Library</string>
    <string name="destination_downloads">Downloads</string>
    <string name="destination_search">Search</string>
    <string name="destination_open_library">Go to your library</string>

    <!-- Sections, revealed by opening the rail on a wide window. The library's own top bar
         carries both on a narrow window and drops them on a wide one, so these are what
         stops a tablet reader reaching neither. -->
    <string name="destination_shelves">Shelves</string>
    <string name="destination_settings">Settings</string>

    <!-- The rail's menu button. The glyph is the whole control, so its name is the
         description a screen reader reads out, and it says what pressing it will do rather
         than what the rail currently is. -->
    <string name="rail_expand">Show more places</string>
    <string name="rail_collapse">Show fewer places</string>


    <string name="downloads_destination_on_device">On this device</string>
    <string name="downloads_destination_in_flight">Coming down now</string>
    <string name="downloads_destination_empty">Nothing is on this device yet. A book you open from an online library is kept here.</string>

    <!-- The downloads destination speaks the vocabulary the settings screen used to. Same
         words, same four languages; only the module they are drawn from changed. -->
    <string name="downloads_total">Space used</string>
    <string name="downloads_stop">Stop</string>
    <string name="downloads_remove">Remove download</string>
    <string name="downloads_cancel">Cancel</string>
    <string name="downloads_remove_title">Remove this download?</string>
    <string name="downloads_remove_body">This deletes the copy of %1$s on this device. Your reading position is kept, and it can be downloaded again.</string>
    <string name="downloads_remove_body_imported">This deletes the copy of %1$s that StoryArc keeps, freeing %2$s. The original file elsewhere on your device is not touched.</string>
    <string name="downloads_remove_action">Remove the download of %1$s</string>
    <!-- Three attempts is the ceiling `offline-downloads` sets, so one of them is a
         real case and reads wrong as "1 attempts". -->
    <plurals name="downloads_failed">
        <item quantity="one">Failed after %2$d attempt: %1$s</item>
        <item quantity="other">Failed after %2$d attempts: %1$s</item>
    </plurals>
    <string name="downloads_paused_by_reader">Paused</string>
    <string name="downloads_paused_waiting_for_wifi">Waiting for Wi-Fi</string>
    <string name="downloads_paused_out_of_space">Not enough space on the device</string>
    <string name="downloads_move_earlier">Move \u201c%1$s\u201d earlier</string>
    <string name="downloads_move_later">Move \u201c%1$s\u201d later</string>
    <string name="downloads_undo">Undo</string>
    <string name="downloads_removed">\u201c%1$s\u201d removed from this device. Your place is kept.</string>
</resources>
