<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose owns every colour once the activity is up. This theme only
         covers the window before the first frame, so the launch is the app
         background rather than a flash of white. -->
    <style name="Theme.StoryArc" parent="android:Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/launch_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
