<?xml version="1.0" encoding="utf-8"?>
<!-- Mono: Ink's plate with the mark in a single ink, for a reader who wants it quiet.
     Drawn by the `MainActivityMono` alias.

     The foreground here is the *monochrome* art rather than the gradient one, which is what
     makes this a face and not only a layer: the same drawable Android tints for a themed
     icon is the one this face draws untinted, so the quiet option and the themed icon are
     the same mark. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_monochrome" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
