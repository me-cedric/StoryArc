<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:tools="http://schemas.android.com/tools" xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- `network-share` and `opds-catalog` reach servers the user configures.
         StoryArc has no backend of its own. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Read, never changed. `offline-downloads` lowers the number of concurrent transfers
         "on a metered connection" and treats Data Saver as metered, and this is the only
         way to know which kind of connection a reader is on. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".StoryArcApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:localeConfig="@xml/locales_config"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.StoryArc">

        <!-- **This activity carries no launcher filter, and it must never be disabled.**
             Every `<activity-alias>` below targets it, and an alias whose target is disabled
             does not merely lose its icon: it stops resolving. Demonstrated on an emulator,
             because no unit test can see it — with `MainActivity` disabled and one alias
             enabled, `am start` on the alias reported "Starting" and left no process, and the
             MAIN/LAUNCHER intent answered *"unable to resolve"*. The launcher still drew the
             icon it had cached. Tapping it did nothing.

             So the launcher entry belongs to the aliases, all five of them, and this activity
             does the two things a face never touches: it is what the aliases point at, and it
             is the handler for a file opened from somewhere else. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density|smallestScreenSize"
            android:theme="@style/Theme.StoryArc">

            <!-- `local-library`: StoryArc must appear in the system's "open with" list
                 for every format it can read. Two filters, because one is not enough.

                 By MIME type, for the providers that declare a real one. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="application/vnd.comicbook+zip" />
                <data android:mimeType="application/vnd.comicbook-rar" />
                <data android:mimeType="application/epub+zip" />
                <data android:mimeType="application/pdf" />
                <!-- An audiobook is a supported publication now, so `local-library`'s
                     "Open-in from another app" applies to one: a reader who taps an M4B in
                     a file manager and does not find StoryArc in the list has no way in
                     that does not start with configuring a source. `audio/mp4` is what a
                     provider calls an M4B; the rest are what it calls the other three. -->
                <data android:mimeType="audio/mp4" />
                <data android:mimeType="audio/mpeg" />
                <data android:mimeType="audio/flac" />
                <data android:mimeType="audio/ogg" />
            </intent-filter>

            <!-- And by extension, because most file managers hand a comic archive over as
                 `application/octet-stream`. CBZ, CBR and CBT have no MIME type a provider
                 reliably knows, so a MIME-only filter leaves StoryArc out of the list for
                 exactly the formats it exists to read.

                 `.cb7` is here although no decoder reads it. `publication-formats` refuses
                 7-Zip by name, and the reader has to reach the refusal to hear it —
                 appearing in the list and saying "StoryArc does not read this" is the
                 requirement, and vanishing from the list is not.

                 Both cases of each extension: `pathPattern` matches literally. -->
            <!-- `AppLinkUrlError` is suppressed, not fixed. Lint treats any VIEW filter
                 carrying a scheme as a web link and asks for a host. A `content://` or
                 `file://` handover has no host to give, and adding one would stop the
                 filter matching. BROWSABLE is deliberately absent for the same reason:
                 this is a file handover, not a link. -->
            <intent-filter tools:ignore="AppLinkUrlError">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.cbz" />
                <data android:pathPattern=".*\\.CBZ" />
                <data android:pathPattern=".*\\.cbr" />
                <data android:pathPattern=".*\\.CBR" />
                <data android:pathPattern=".*\\.cb7" />
                <data android:pathPattern=".*\\.CB7" />
                <data android:pathPattern=".*\\.cbt" />
                <data android:pathPattern=".*\\.CBT" />
                <data android:pathPattern=".*\\.epub" />
                <data android:pathPattern=".*\\.EPUB" />
                <data android:pathPattern=".*\\.pdf" />
                <data android:pathPattern=".*\\.PDF" />
                <!-- And the audiobook containers, for the same reason the comic archives
                     are here: `.m4b` has no MIME type a provider reliably knows, and a
                     MIME-only filter leaves StoryArc out of the list for the format this
                     change exists to open. -->
                <data android:pathPattern=".*\\.m4b" />
                <data android:pathPattern=".*\\.M4B" />
                <data android:pathPattern=".*\\.m4a" />
                <data android:pathPattern=".*\\.M4A" />
                <data android:pathPattern=".*\\.mp3" />
                <data android:pathPattern=".*\\.MP3" />
                <data android:pathPattern=".*\\.flac" />
                <data android:pathPattern=".*\\.FLAC" />
                <data android:pathPattern=".*\\.ogg" />
                <data android:pathPattern=".*\\.OGG" />
                <data android:pathPattern=".*\\.opus" />
                <data android:pathPattern=".*\\.OPUS" />
            </intent-filter>

            <!-- A share sheet sends the file as an extra rather than as the intent's data,
                 and `local-library` names the share sheet as one of the three ways in. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/vnd.comicbook+zip" />
                <data android:mimeType="application/vnd.comicbook-rar" />
                <data android:mimeType="application/epub+zip" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="audio/mp4" />
                <data android:mimeType="audio/mpeg" />
                <data android:mimeType="audio/flac" />
                <data android:mimeType="audio/ogg" />
            </intent-filter>
        </activity>

        <!-- The five app icons, one `<activity-alias>` each.

             `settings-and-about` lets a reader choose the app's icon, and this platform has
             no `setAlternateIconName`: the only way to change what a launcher draws is to
             have several launcher components and enable exactly one. `AppIconAliases` owns
             the switching and `AppIconSwitcher` performs it.

             **Ink has an alias of its own, and that is a correction.** The design document
             asks for the default to be `MainActivity` itself so that a fresh install and a
             reset land in the same state — but on this platform that shape breaks the app:
             switching to any other face means disabling `MainActivity`, and an alias whose
             target is disabled stops resolving, so the reader is left with an icon that does
             nothing. The *reason* behind 4.5 survives intact: a reset writes
             `COMPONENT_ENABLED_STATE_DEFAULT` to all five components, which is byte for byte
             what a fresh install holds. Only the mechanism moved.

             **Exactly one of these five may ever be enabled**, and `MainActivity` is never
             one of them. Zero enabled makes StoryArc vanish from the launcher with no way
             back from inside the app; a reader would have to reinstall it. That is why the
             swap is a planner with a test rather than two calls at a press.

             Each alias carries **only** the launcher filter. The VIEW and SEND filters stay
             on `MainActivity` alone: they are how a file reaches the app, they are not about
             icons, and five copies of them would put StoryArc in the "open with" list five
             times over the moment more than one component were enabled.

             `android:label` is repeated rather than inherited because a launcher reads the
             alias's own label, and an unlabelled alias shows the activity's name. -->
        <activity-alias
            android:name=".MainActivityInk"
            android:targetActivity=".MainActivity"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".MainActivityPaper"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_paper"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".MainActivityBloom"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_bloom"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".MainActivityArc"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_arc"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".MainActivityMono"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_mono"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
