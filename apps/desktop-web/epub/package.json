    "check:selftest": "node check-pin.mjs --self-test",
    "egress": "node test/collector.mjs",
    "egress:selftest": "node test/collector.mjs --self-test"
  },
  "dependencies": {
    "@readium/navigator": "2.11.1",
    "@readium/shared": "2.7.0"
  },
  "devDependencies": {
    "playwright-core": "1.60.0",
    "vite": "8.3.4"
  }
}
