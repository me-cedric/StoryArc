* text=auto eol=lf

*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.avif  binary
*.pdf   binary
*.cbz   binary
*.cbr   binary
*.epub  binary
*.jar   binary
*.keystore binary

# Vendored third-party sources keep their upstream bytes exactly. VENDORING.md
# claims a reviewer can diff them against the release tarball, and normalising
# line endings would break that claim for the files that ship with CRLF.
third_party/**  -text

*.cbt   binary
*.cb7   binary

gradlew         text eol=lf
*.bat           text eol=crlf
*.pbxproj       -text merge=union

# projectmem shared event log (source of truth)
.projectmem/events.jsonl merge=union
