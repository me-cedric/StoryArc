{
  "mcpServers": {
    "konvoy": {
      "args": [
        "--mcp"
      ],
      "command": "/Applications/Konvoy.app/Contents/MacOS/konvoy"
    },
    "agent-device": {
      "command": "npx",
      "args": [
        "-y",
        "agent-device@0.21.22",
        "mcp"
      ]
    },
    "codebase-memory": {
      "command": "codebase-memory-mcp",
      "args": [
        "--tool-profile=analysis"
      ]
    },
    "xcodebuildmcp": {
      "command": "npx",
      "args": [
        "-y",
        "xcodebuildmcp@2.7.0",
        "mcp"
      ]
    }
  }
}
