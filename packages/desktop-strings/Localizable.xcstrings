    "desktop.w3.shelves.conflictBody___": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jemand hat „%@“ zuerst auf dem Server geändert, daher wurden deine wartenden Ergänzungen verworfen: %@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Someone changed “%@” on the server first, so your waiting additions were dropped: %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguien cambió «%@» antes en el servidor, así que se descartaron tus adiciones pendientes: %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelqu’un a modifié « %@ » avant vous sur le serveur ; vos ajouts en attente ont été abandonnés : %@."
          }
        }
      }
    },
