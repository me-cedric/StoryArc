    "secrets.denied": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Schlüsselbund wurde nicht entsperrt, daher wurde nichts gespeichert. Melden Sie sich erneut an, sobald er entsperrt ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The keyring was not unlocked, so nothing was saved. Sign in again once it is."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El llavero no se desbloqueó, así que no se guardó nada. Vuelve a iniciar sesión cuando lo esté."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le trousseau n’a pas été déverrouillé, donc rien n’a été enregistré. Reconnectez-vous une fois qu’il l’est."
          }
        }
      }
    },
    "secrets.flatpak": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Passwörter werden im verschlüsselten Schlüsselbund dieser App aufbewahrt, über das Secret-Portal des Desktops."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Passwords are kept in this app's encrypted keyring, through the desktop's Secret portal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las contraseñas se guardan en el llavero cifrado de esta aplicación, a través del portal Secret del escritorio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mots de passe sont conservés dans le trousseau chiffré de cette application, via le portail Secret du bureau."
          }
        }
      }
    },
    "secrets.service": {
