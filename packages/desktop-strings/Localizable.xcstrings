          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En cours (%@)"
          }
        }
      }
    },
    "desktop.w3.downloads.metered": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Verbindung ist getaktet, daher warten Downloads, die du nicht selbst gestartet hast. Du kannst weiterhin selbst einen starten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This connection is metered, so downloads you did not start wait. You can still start one yourself."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta conexión tiene tarifa limitada, así que las descargas que no iniciaste esperan. Aún puedes iniciar una tú."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette connexion est limitée : les téléchargements que vous n’avez pas lancés attendent. Vous pouvez toujours en lancer un vous-même."
          }
        }
      }
    },
    "desktop.w3.downloads.queueEmpty": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts wartet auf den Download."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is waiting to download."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay nada esperando para descargarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n’attend d’être téléchargé."
          }
        }
      }
    },
    "desktop.w3.downloads.queued": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wartet, bis es an der Reihe ist"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting its turn"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esperando su turno"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En attente de son tour"
          }
        }
      }
    },
    "desktop.w3.downloads.quitBody": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Download läuft. Er pausiert, behält das Geladene und wird beim nächsten Start von StoryArc fortgesetzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A download is in progress. It pauses, keeps what it has, and resumes the next time StoryArc opens."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay una descarga en curso. Se pausa, conserva lo descargado y continúa la próxima vez que abras StoryArc."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un téléchargement est en cours. Il se met en pause, garde ce qu’il a reçu et reprend à la prochaine ouverture de StoryArc."
          }
        }
      }
    },
    "desktop.w3.downloads.quitConfirm": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausieren und beenden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause and quit"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausar y salir"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettre en pause et quitter"
          }
        }
      }
    },
    "desktop.w3.downloads.quitTitle": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Download pausieren und beenden?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause the download and quit?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Pausar la descarga y salir?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettre le téléchargement en pause et quitter ?"
          }
        }
      }
    },
