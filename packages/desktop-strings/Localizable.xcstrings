    "sync.status.timedOut": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Synchronisierungsordner hat nicht rechtzeitig geantwortet. StoryArc synchronisiert beim nächsten Mal erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sync folder did not answer in time. StoryArc syncs again next time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La carpeta de sincronización no respondió a tiempo. StoryArc volverá a sincronizar la próxima vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dossier de synchronisation n’a pas répondu à temps. StoryArc se synchronisera de nouveau la prochaine fois."
          }
        }
      }
    },
    "sync.status.unreachable.place": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Synchronisierungsordner ist nicht erreichbar. StoryArc synchronisiert erneut, sobald es möglich ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sync folder cannot be reached. StoryArc syncs again when it can."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede acceder a la carpeta de sincronización. StoryArc volverá a sincronizar en cuanto pueda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dossier de synchronisation est inaccessible. StoryArc se synchronisera de nouveau dès qu’il le pourra."
          }
        }
      }
    },
