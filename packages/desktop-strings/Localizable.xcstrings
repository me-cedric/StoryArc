    "settings.appearance.noPortal": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Sitzung nennt ihr Erscheinungsbild nicht, daher zeichnet System hell."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This session does not state its appearance, so System draws light."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta sesión no indica su apariencia, así que Sistema dibuja en claro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette session n’indique pas son apparence, donc Système dessine en clair."
          }
        }
      }
    },
    "settings.appearance.pending": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gespeichert. Dieses Erscheinungsbild wird in einer späteren Version gezeichnet; die Oberfläche zeigt vorerst das nächstliegende."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved. This appearance is drawn in a later version; the chrome shows the nearest one for now."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardado. Esta apariencia se dibujará en una versión posterior; por ahora la interfaz muestra la más cercana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistré. Cette apparence sera dessinée dans une version ultérieure ; l’interface affiche la plus proche pour l’instant."
          }
        }
      }
    },
    "settings.clickZones": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
