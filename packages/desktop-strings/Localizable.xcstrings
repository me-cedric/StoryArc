    "desktop.command.openFile": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Datei öffnen…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open File…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir archivo…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrir un fichier…"
          }
        }
      }
    },
