    "smb.discovery.absent": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses System meldet keine Freigaben an (Avahi läuft nicht). Geben Sie die Adresse daher von Hand ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This system does not announce shares (Avahi is not running), so enter the address by hand."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este sistema no anuncia recursos compartidos (Avahi no está en ejecución), así que escribe la dirección a mano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce système n’annonce aucun partage (Avahi n’est pas lancé) : saisissez l’adresse à la main."
          }
        }
      }
    },
