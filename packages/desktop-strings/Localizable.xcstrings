    "desktop.w3.shelves.none": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Regale. Lege eine Sammlung oder Leseliste an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No shelves yet. Create a collection or a reading list."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay estantes. Crea una colección o una lista de lectura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune étagère pour l’instant. Créez une collection ou une liste de lecture."
          }
        }
      }
    },
    "desktop.w3.shelves.notHere": {
      "extractionState": "manual",
      "localizations": {
