            "state": "translated",
            "value": "StoryArc could not save that."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "StoryArc no pudo guardar eso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "StoryArc n’a pas pu enregistrer cela."
          }
        }
      }
    },
