    "downloads.unmetered.note": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei einer Verbindung, die Ihr System als getaktet kennzeichnet, warten Downloads, die Sie nicht von Hand gestartet haben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On a connection your system marks as metered, downloads you did not start by hand wait."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En una conexión que tu sistema marca como medida, las descargas que no iniciaste a mano esperan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur une connexion que votre système signale comme limitée, les téléchargements que vous n’avez pas lancés à la main attendent."
          }
        }
      }
    },
