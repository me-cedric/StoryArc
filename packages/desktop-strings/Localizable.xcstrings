    "downloads.quit.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Download wird pausiert, wenn StoryArc beendet wird, und setzt sich beim nächsten Öffnen von StoryArc dort fort, wo er angehalten hat. Der bereits geladene Teil bleibt erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It pauses when StoryArc quits and resumes from where it stopped the next time you open StoryArc. The part already downloaded is kept."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La descarga se pausa al cerrar StoryArc y continúa desde donde se detuvo la próxima vez que abras StoryArc. La parte ya descargada se conserva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le téléchargement se met en pause quand StoryArc se ferme et reprend là où il s’était arrêté à la prochaine ouverture de StoryArc. La partie déjà téléchargée est conservée."
          }
        }
      }
    },
