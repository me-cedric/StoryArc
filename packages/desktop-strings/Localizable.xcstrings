    "downloads.unmetered": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf getakteter Verbindung warten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wait on a metered connection"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esperar con una conexión medida"
          }
        },
        "fr": {
