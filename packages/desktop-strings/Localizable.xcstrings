    "desktop.w3.downloads.diskFull": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Datenträger ist voll. Schaffe Platz oder leere einen Cache und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The disk is full. Free up space or clear a cache, then retry."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El disco está lleno. Libera espacio o vacía una caché y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le disque est plein. Libérez de l’espace ou videz un cache, puis réessayez."
          }
        }
      }
    },
    "desktop.w3.downloads.inProgress___": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In Arbeit (%@)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In progress (%@)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
