{
  "sourceLanguage": "en",
  "strings": {
    "desktop.command.openFile": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Datei öffnen…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open File…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir archivo…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrir un fichier…"
          }
        }
      }
    },
    "desktop.w3.diagnostic.cannotWrite___": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ kann nicht geschrieben werden: %@. Wähle einen anderen Ort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” cannot be written: %@. Choose another place."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede escribir «%@»: %@. Elige otro lugar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » ne peut pas être écrit : %@. Choisissez un autre emplacement."
          }
        }
      }
    },
    "desktop.w3.diagnostic.close": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerrar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fermer"
          }
        }
      }
    },
    "desktop.w3.diagnostic.save": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In Datei speichern …"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save to a file…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardar en un archivo…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrer dans un fichier…"
          }
        }
      }
    },
    "desktop.w3.diagnostic.saved___": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gespeichert unter %@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved to %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardado en %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistré dans %@."
          }
        }
      }
    },
    "desktop.w3.downloads.diskFull": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Datenträger ist voll. Schaffe Platz oder leere einen Cache und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The disk is full. Free up space or clear a cache, then retry."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El disco está lleno. Libera espacio o vacía una caché y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le disque est plein. Libérez de l’espace ou videz un cache, puis réessayez."
          }
        }
      }
    },
    "desktop.w3.downloads.inProgress___": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In Arbeit (%@)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In progress (%@)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En curso (%@)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En cours (%@)"
          }
        }
      }
    },
    "desktop.w3.downloads.metered": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Verbindung ist getaktet, daher warten Downloads, die du nicht selbst gestartet hast. Du kannst weiterhin selbst einen starten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This connection is metered, so downloads you did not start wait. You can still start one yourself."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta conexión tiene tarifa limitada, así que las descargas que no iniciaste esperan. Aún puedes iniciar una tú."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette connexion est limitée : les téléchargements que vous n’avez pas lancés attendent. Vous pouvez toujours en lancer un vous-même."
          }
        }
      }
    },
    "desktop.w3.downloads.queueEmpty": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts wartet auf den Download."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is waiting to download."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay nada esperando para descargarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n’attend d’être téléchargé."
          }
        }
      }
    },
    "desktop.w3.downloads.queued": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wartet, bis es an der Reihe ist"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting its turn"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esperando su turno"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En attente de son tour"
          }
        }
      }
    },
    "desktop.w3.downloads.quitBody": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Download läuft. Er pausiert, behält das Geladene und wird beim nächsten Start von StoryArc fortgesetzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A download is in progress. It pauses, keeps what it has, and resumes the next time StoryArc opens."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay una descarga en curso. Se pausa, conserva lo descargado y continúa la próxima vez que abras StoryArc."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un téléchargement est en cours. Il se met en pause, garde ce qu’il a reçu et reprend à la prochaine ouverture de StoryArc."
          }
        }
      }
    },
    "desktop.w3.downloads.quitConfirm": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausieren und beenden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause and quit"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausar y salir"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettre en pause et quitter"
          }
        }
      }
    },
    "desktop.w3.downloads.quitTitle": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Download pausieren und beenden?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause the download and quit?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Pausar la descarga y salir?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettre le téléchargement en pause et quitter ?"
          }
        }
      }
    },
    "desktop.w3.downloads.signInNeeded": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Quelle hat die Anmeldung abgelehnt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The source refused the sign-in."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La fuente rechazó el inicio de sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La source a refusé la connexion."
          }
        }
      }
    },
    "desktop.w3.downloads.waitingForConnection": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warten auf eine Verbindung"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for a connection"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esperando una conexión"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En attente d’une connexion"
          }
        }
      }
    },
    "desktop.w3.downloads.waitingForUnmetered": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warten auf eine Verbindung ohne Datenlimit"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for an unmetered connection"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esperando una conexión sin límite de datos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En attente d’une connexion non limitée"
          }
        }
      }
    },
    "desktop.w3.downloads.willRetry": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird gleich erneut versucht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Will try again in a moment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se volverá a intentar en un momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nouvel essai dans un instant."
          }
        }
      }
    },
    "desktop.w3.shelves.addToShelf": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu Regal hinzufügen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add to shelf"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añadir a estante"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouter à une étagère"
          }
        }
      }
    },
    "desktop.w3.shelves.conflictBody___": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jemand hat „%@“ zuerst auf dem Server geändert, daher wurden deine wartenden Ergänzungen verworfen: %@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Someone changed “%@” on the server first, so your waiting additions were dropped: %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguien cambió «%@» antes en el servidor, así que se descartaron tus adiciones pendientes: %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelqu’un a modifié « %@ » avant vous sur le serveur ; vos ajouts en attente ont été abandonnés : %@."
          }
        }
      }
    },
    "desktop.w3.shelves.newCollectionName": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neue Sammlung"
          }
        },
        "en": {
          "stringUnit": {
