            "state": "translated",
            "value": "Afficher dans le dossier"
          }
        }
      }
    },
    "library.notWatched": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht live überwacht: alle 10 Sekunden und beim Vorholen dieses Fensters geprüft."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not watched live: checked every 10 seconds and when this window comes forward."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se vigila en directo: se comprueba cada 10 segundos y cuando esta ventana pasa al frente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Non surveillé en direct : vérifié toutes les 10 secondes et quand cette fenêtre passe au premier plan."
          }
        }
      }
    },
