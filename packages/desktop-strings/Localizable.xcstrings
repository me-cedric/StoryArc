    "storage.diskFull": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Datenträger ist voll. StoryArc hat behalten, was es hatte. Das Leeren des Cover-Caches oder das Entfernen eines Downloads schafft Platz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The disk is full. StoryArc kept what it had. Clearing the cover cache or a download frees space."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El disco está lleno. StoryArc conservó lo que tenía. Vaciar la caché de portadas o borrar una descarga libera espacio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le disque est plein. StoryArc a conservé ce qu’il avait. Vider le cache des couvertures ou supprimer un téléchargement libère de l’espace."
          }
        }
      }
    },
