    "storage.where": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "StoryArc legt seine Daten in Ihren eigenen Ordnern ab. Nichts davon wird zwischen Rechnern synchronisiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "StoryArc keeps its data in your own folders. Nothing here is synchronised between machines."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "StoryArc guarda sus datos en tus propias carpetas. Nada de esto se sincroniza entre equipos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "StoryArc garde ses données dans vos propres dossiers. Rien ici n’est synchronisé entre les machines."
          }
        }
      }
    },
