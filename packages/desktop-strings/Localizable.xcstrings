    "desktop.w3.sources.credentialRefused___": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows hat das Passwort nicht gespeichert: %@. Nichts wurde gespeichert, daher braucht diese Quelle eine Anmeldung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows did not keep the password: %@. Nothing was saved, so this source needs a sign-in."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows no guardó la contraseña: %@. No se guardó nada, así que esta fuente necesita iniciar sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows n’a pas conservé le mot de passe : %@. Rien n’a été enregistré : cette source demande une connexion."
          }
        }
      }
    },
    "desktop.w3.sources.credentialTooLong": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist länger als die 2560 Bytes, die die Windows-Anmeldeinformationsverwaltung speichert. Nichts wurde gespeichert, daher braucht diese Quelle eine Anmeldung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That is longer than the 2560 bytes Windows Credential Manager keeps. Nothing was saved, so this source needs a sign-in."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es más largo que los 2560 bytes que guarda el Administrador de credenciales de Windows. No se guardó nada, así que esta fuente necesita iniciar sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C’est plus long que les 2560 octets que conserve le Gestionnaire d’informations d’identification de Windows. Rien n’a été enregistré : cette source demande une connexion."
          }
        }
      }
    },
    "desktop.w3.sources.discoveryAbsent": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows bietet StoryArc keine Möglichkeit, Freigaben im Netzwerk zu finden. Gib stattdessen die Adresse des Computers ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows gives StoryArc no way to find shares on your network. Type the address of the computer instead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows no ofrece a StoryArc ninguna forma de encontrar recursos compartidos en tu red. Escribe la dirección del equipo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows ne permet pas à StoryArc de trouver les partages de votre réseau. Saisissez plutôt l’adresse de l’ordinateur."
          }
        }
      }
    },
