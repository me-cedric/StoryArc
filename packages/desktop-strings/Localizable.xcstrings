          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasar páginas haciendo clic en los bordes"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tourner les pages en cliquant sur les bords"
          }
