    },
    "secrets.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es läuft kein Secret Service, daher bleiben Passwörter nur bis zum Beenden von StoryArc erhalten. Starten Sie GNOME Keyring, KWallet, KeePassXC oder oo7-daemon, um sie zu behalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Secret Service is running, so passwords are kept until StoryArc quits. Start GNOME Keyring, KWallet, KeePassXC or oo7-daemon to keep them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay ningún servicio de secretos en marcha, así que las contraseñas se conservan hasta que StoryArc se cierra. Inicia GNOME Keyring, KWallet, KeePassXC u oo7-daemon para conservarlas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun service de secrets ne tourne, donc les mots de passe sont conservés jusqu’à la fermeture de StoryArc. Lancez GNOME Keyring, KWallet, KeePassXC ou oo7-daemon pour les garder."
          }
        }
      }
    },
