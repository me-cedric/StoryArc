    "downloads.clear.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das löscht die heruntergeladenen Kopien auf diesem Gerät und stoppt, was gerade geladen wird. Ihre Lesepositionen bleiben erhalten, und jeder Titel kann erneut geladen werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This deletes the downloaded copies on this device and stops what is coming down. Your reading positions are kept, and each can be downloaded again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto borra las copias descargadas en este dispositivo y detiene lo que se está descargando. Tus posiciones de lectura se conservan, y cada título se puede descargar de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime les copies téléchargées sur cet appareil et arrête ce qui est en cours de téléchargement. Vos positions de lecture sont conservées, et chaque titre peut être téléchargé de nouveau."
          }
        }
      }
    },
    "downloads.clear.title": {
      "extractionState": "manual",
      "localizations": {
