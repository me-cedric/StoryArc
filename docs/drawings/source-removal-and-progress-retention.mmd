flowchart TD
    tap["Reader taps Remove on a source"]
    cost["State the cost first: how many files, how many bytes"]
    confirm{"Confirmed?"}
    nothing["Nothing changes"]
    plan["SourceRemoval.of decides what goes, and in which order"]

    secret["1. Delete the secret, by the reference the registry stored"]
    cache["2. Drop the cached metadata and covers"]
    downloads["3. Delete the source's downloads"]
    registry["4. SourceRegistry.removing"]

    gone["Source leaves the ordered list"]
    stone["Tombstone written: sourceId and removedAt"]
    progress["Reading progress stays on disk"]

    clock{"Re-added within 30 days?"}
    restore["SourceRegistry.readding clears the tombstone"]
    resume["Reader resumes where they stopped"]
    collect["collectingExpiredTombstones returns the expired ids"]
    forget["The caller deletes the progress rows"]

    tap --> cost
    cost --> confirm
    confirm -->|No| nothing
    confirm -->|Yes| plan
    plan --> secret
    secret --> cache
    cache --> downloads
    downloads --> registry
    registry --> gone
    registry --> stone
    stone -->|"removal does NOT cascade here"| progress
    progress --> clock
    clock -->|Yes| restore
    restore --> resume
    clock -->|No| collect
    collect --> forget
