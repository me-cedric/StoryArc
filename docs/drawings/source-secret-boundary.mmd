%% The source secret boundary
%%
%% The one path a source secret takes in, the one place it rests, and the edges it is not
%% allowed to cross. Board for the `source-lifecycle` change, requirement 2
%% (Credential storage).
%%
%% Read from:
%%   apps/android/core/persistence/.../CredentialStore.kt
%%   apps/ios/Packages/StoryArcKit/Sources/Persistence/CredentialStore.swift
%%   apps/ios/Packages/StoryArcKit/Sources/StoryArcCore/DiagnosticRedaction.swift
%%   apps/ios/Packages/StoryArcKit/Sources/SettingsFeature/Diagnostic.swift
%%
%% The registry holding an opaque reference and nothing else is what makes the promise
%% structural rather than a habit. The proposal names the diagnostic export as a risk:
%% sources add the first values that could carry a hostname or a token.
    enter["Reader enters a secret in the add sheet"]
    open{"CredentialStore.open<br/>gives a key?"}
    refuse["Refuse to save a source that needs a secret.<br/>Never a plaintext fallback — a device with no<br/>usable keystore cannot hold a secret safely, and<br/>writing one to an ordinary preference to keep the<br/>feature working is what the requirement forbids."]
    save["CredentialStore.save<br/>one entry per source, keyed by its id —<br/>not one blob holding a map, so removing a<br/>source is a delete rather than read-edit-write"]

    vault[["Platform secure store<br/><br/>iOS: the Keychain<br/>Android: an AES-256-GCM key in the Android<br/>Keystore, ciphertext in an ordinary preference.<br/>The key never enters the app's memory."]]

    ref["Source.credentialReference<br/>an opaque handle — all the registry ever holds"]

    use["A request needs to authenticate"]
    readback["Read from the secure store<br/>at the moment of use"]
    discard["Not retained beyond the request"]

    removal["Removal deletes the secret<br/>by this reference"]

    logline["A log line, an error message,<br/>or a URL with embedded credentials"]
    redact["DiagnosticRedaction strips the credential<br/>before the line leaves memory"]

    bundle["The exported diagnostic bundle"]
    counted["The Sources section carries a count,<br/>never a list.<br/>A display name is text the reader typed, which<br/>is exactly where a hostname would be — so the<br/>report does not carry it at all, rather than<br/>carrying it redacted."]

    enter --> open
    open -->|No| refuse
    open -->|Yes| save
    save --> vault
    save --> ref
    use --> readback
    ref --> readback
    vault --> readback
    readback --> discard
    ref --> removal
    removal --> vault
    logline --> redact
    bundle --> counted

    forbidden["A secret never reaches any of these:<br/>preferences, logs, crash reports,<br/>backups, exported diagnostics"]
    vault -.- forbidden
