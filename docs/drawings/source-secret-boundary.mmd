flowchart TD
    enter["Reader enters a secret in the add sheet"]
    open{"CredentialStore.open gives a key?"}
    refuse["Refuse to save the source. Never a plaintext fallback"]
    save["CredentialStore.save: one entry per source, keyed by its id"]

    vault["Platform secure store: iOS Keychain, or Android Keystore"]
    ref["Source.credentialReference: an opaque handle"]

    use["A request needs to authenticate"]
    readback["Read from the secure store at the moment of use"]
    discard["Not retained beyond the request"]

    removal["Removal deletes the secret by this reference"]

    logline["A log line, an error, or a URL carrying credentials"]
    redact["DiagnosticRedaction strips the credential"]
    bundle["The exported diagnostic bundle"]
    counted["The Sources section carries a count, never a list"]

    forbidden["Never reached: preferences, logs, crash reports, backups, exports"]

    enter --> open
    open -->|No| refuse
    open -->|Yes| save
    save --> vault
    save --> ref
    use --> readback
    ref --> readback
    vault --> readback
    readback --> discard
    ref --> removal
    removal --> vault
    logline --> redact
    redact --> bundle
    bundle --> counted
    vault -->|"a secret never crosses this edge"| forbidden
