// The StoryArc model, at the C4 context and container levels.
//
// Every element below corresponds to a directory, a build target, or a system
// the app talks to. The module lists are transcribed from
// apps/ios/Packages/*/Package.swift, apps/ios/project.yml and
// apps/android/settings.gradle.kts; the edges are transcribed from the
// `dependencies` sections of those same files.
model {

  reader = person 'Reader' 'Reads comics and ebooks from sources they configured themselves.'

  // ---------------------------------------------------------------------
  // The single most important fact: two applications, no shared runtime.
  // ADR-0001. There is deliberately no edge between them.
  // ---------------------------------------------------------------------

  ios = app 'StoryArc for iOS' {
    #ios
    description '''
      Swift and SwiftUI, iOS 26 floor. One Xcode app target composing two
      local SPM packages. Depends on nothing in apps/android.
    '''
    technology 'Swift 6, SwiftUI'

    iosApp = module 'StoryArc' {
      description 'The app target. Generated from project.yml by XcodeGen; the .xcodeproj is not committed.'
      technology 'SwiftUI App'
    }

    kit = package 'StoryArcKit' {
      description '''
        One package, one dependency graph. Every feature is a target here
        rather than a separate package, so the module boundaries stay visible
        in a single manifest. Also builds for macOS so the pure-Swift targets
        are host-testable without a simulator.
      '''

      core = module 'StoryArcCore' 'The domain types. Depends on nothing.'

      designSystem = module 'DesignSystem' 'Generated tokens, typography and the shared SwiftUI chrome.'

      formats = module 'Formats' {
        description 'Archive and document parsing: ZIP, TAR, RAR, PDF, EPUB metadata, image folders.'
      }

      persistence = module 'Persistence' {
        description 'The library index, reading progress, downloads, and the credential store.'
        technology 'SwiftData, Keychain'
      }

      catalogue = module 'Catalogue' 'OPDS 1.2 and 2.0 feed parsing.'

      kavita = module 'Kavita' 'The Kavita REST client, layered on Catalogue.'

      smb = module 'Smb' {
        description 'The SMB seam. Everything above it works against RandomAccessSource and learns nothing about the protocol.'
        technology 'SMBClient 0.3.1 (ADR-0010)'
      }

      libraryFeature = module 'LibraryFeature' 'Library browsing, source management, downloads.'

      readerFeature = module 'ReaderFeature' 'The comic and PDF reader.'

      settingsFeature = module 'SettingsFeature' 'Settings and about.'
    }

    epubPackage = package 'StoryArcEpub' {
      description '''
        A second package, and only because of a platform floor: the Readium
        Swift toolkit declares iOS support only, and StoryArcKit also builds
        for macOS. SwiftPM validates the dependency graph for every declared
        platform, so Readium cannot live in StoryArcKit.
      '''

      epubReaderFeature = module 'EpubReaderFeature' {
        description 'Reflowable and fixed-layout EPUB rendering.'
        technology 'Readium Swift toolkit 3.11.0'
      }
    }
  }

  android = app 'StoryArc for Android' {
    #android
    description '''
      Kotlin and Compose, API 31 floor. Flat Gradle modules under a single
      settings.gradle.kts. Depends on nothing in apps/ios.
    '''
    technology 'Kotlin, Jetpack Compose'

    androidApp = module ':app' 'The application module. Composes every feature.'

    coreModel = module ':core:model' 'The domain types. Depends on nothing.'

    coreDesignSystem = module ':core:designsystem' 'Generated tokens, typography and the shared Compose chrome.'

    coreFormat = module ':core:format' {
      description 'Archive and document parsing: ZIP, TAR, RAR, PDF, EPUB metadata, image folders, SAF trees.'
    }

    corePersistence = module ':core:persistence' {
      description 'The library index, reading progress, downloads, and the credential store.'
      technology 'Room, Android Keystore'
    }

    coreCatalogue = module ':core:catalogue' 'OPDS 1.2 and 2.0 feed parsing.'

    coreKavita = module ':core:kavita' 'The Kavita REST client, layered on core:catalogue.'

    coreSmb = module ':core:smb' {
      description 'The SMB seam, mirroring the iOS one.'
      technology 'jcifs-ng'
    }

    featureLibrary = module ':feature:library' 'Library browsing, source management, downloads.'

    featureReader = module ':feature:reader' 'The comic and PDF reader.'

    featureEpubReader = module ':feature:epubreader' {
      description 'Reflowable and fixed-layout EPUB rendering. A feature module here, because Android has no platform floor forcing a separate package.'
      technology 'Readium Kotlin toolkit'
    }

    featureSettings = module ':feature:settings' 'Settings and about.'
  }

  // ---------------------------------------------------------------------
  // What the two apps DO share. All of it declarative, none of it a runtime.
  // ---------------------------------------------------------------------

  shared = artefact 'Shared artefacts' {
    #shared
    description '''
      Committed files both builds read. No compiled artefact crosses between
      the apps; nothing here is a library either app links against, except the
      vendored C sources, which are compiled twice from one copy.
    '''

    specs = artefact 'Capability specs' {
      description 'docs/openspec/specs — 17 capability specifications. The behaviour contract, and the only definition of what "the same app" means.'
      technology 'Markdown, validated by pnpm spec:validate'
    }

    tokens = artefact 'Design tokens' {
      description 'packages/design-tokens — OKLCH token source, generated into Swift and Kotlin. A contrast gate fails the build on a pair below its WCAG floor.'
      technology 'JSON, generated'
    }

    fixtures = artefact 'Test fixtures' {
      description 'packages/test-fixtures — a generated publication corpus, committed. Both test suites read the same manifest.json and assert the same expectations.'
      technology 'Generated corpus'
    }

    fonts = artefact 'Bundled typefaces' {
      description 'packages/fonts — one copy on disk, read as an SPM resource by iOS and as an asset source by Android.'
    }

    licences = artefact 'Licence inventory' {
      description 'packages/licences — the third-party licence list rendered in the About screen on both platforms.'
    }

    libarchive = artefact 'libarchive (vendored)' {
      description '''
        third_party/libarchive — 26 of libarchive 3.8.9 sources, vendored once
        and compiled by two build systems: SwiftPM on iOS, CMake and the NDK on
        Android, against one hand-authored config.h. It exists for exactly one
        job, decompressing a RAR entry. This is the only C the two apps have in
        common, and the only place a build-level divergence could hide.
      '''
      technology 'C, BSD-2-Clause'
    }
  }

  // ---------------------------------------------------------------------
  // The outside world. Four source types, and nothing the project operates.
  // ---------------------------------------------------------------------

  deviceStorage = externalSystem 'Device storage' {
    description 'Files on the device or in a document provider. The zero-configuration source: open a file or folder and read it.'
    technology 'Files app / Storage Access Framework'
  }

  smbShare = externalSystem 'SMB share' {
    description 'A network share the reader configured. Read with ranged requests so a publication streams without a full download.'
    technology 'SMB 2/3'
  }

  opdsCatalogue = externalSystem 'OPDS catalogue' {
    description 'Any OPDS 1.2 or 2.0 feed the reader points the app at.'
    technology 'OPDS over HTTPS'
  }

  kavitaServer = externalSystem 'Kavita server' {
    description 'A self-hosted Kavita instance the reader configured, with its own account and API key.'
    technology 'Kavita REST API'
  }

  noBackend = absent 'No StoryArc service' {
    #absence
    description '''
      There is no such component, and that is the design. StoryArc has no
      backend, no account system, no analytics, no crash reporting and no
      telemetry endpoint. Data leaves the device only to a source the reader
      configured, which is why every arrow out of the two apps lands on
      something the reader owns or chose.
    '''
  }

  // ---------------------------------------------------------------------
  // People and systems
  // ---------------------------------------------------------------------

  reader -> ios 'reads on'
  reader -> android 'reads on'

  reader -> deviceStorage 'owns files on'
  reader -> smbShare 'operates'
  reader -> opdsCatalogue 'chooses'
  reader -> kavitaServer 'self-hosts'

  ios -> shared.specs 'implements'
  ios -> shared.tokens 'generates from'
  ios -> shared.fixtures 'asserts against'
  ios -> shared.fonts 'bundles'
  ios -> shared.licences 'renders'

  android -> shared.specs 'implements'
  android -> shared.tokens 'generates from'
  android -> shared.fixtures 'asserts against'
  android -> shared.fonts 'bundles'
  android -> shared.licences 'renders'

  // ---------------------------------------------------------------------
  // iOS build graph. Transcribed from Package.swift and project.yml.
  // ---------------------------------------------------------------------

  ios.iosApp -[dependsOn]-> ios.kit.designSystem
  ios.iosApp -[dependsOn]-> ios.kit.core
  ios.iosApp -[dependsOn]-> ios.kit.libraryFeature
  ios.iosApp -[dependsOn]-> ios.kit.readerFeature
  ios.iosApp -[dependsOn]-> ios.kit.settingsFeature
  ios.iosApp -[dependsOn]-> ios.kit.persistence
  ios.iosApp -[dependsOn]-> ios.epubPackage.epubReaderFeature

  ios.kit.designSystem -[dependsOn]-> ios.kit.core
  ios.kit.formats -[dependsOn]-> ios.kit.core
  ios.kit.persistence -[dependsOn]-> ios.kit.core
  ios.kit.catalogue -[dependsOn]-> ios.kit.core
  ios.kit.kavita -[dependsOn]-> ios.kit.core
  ios.kit.kavita -[dependsOn]-> ios.kit.catalogue
  ios.kit.smb -[dependsOn]-> ios.kit.core
  ios.kit.smb -[dependsOn]-> ios.kit.formats

  ios.kit.libraryFeature -[dependsOn]-> ios.kit.designSystem
  ios.kit.libraryFeature -[dependsOn]-> ios.kit.core
  ios.kit.libraryFeature -[dependsOn]-> ios.kit.formats
  ios.kit.libraryFeature -[dependsOn]-> ios.kit.persistence
  ios.kit.libraryFeature -[dependsOn]-> ios.kit.catalogue
  ios.kit.libraryFeature -[dependsOn]-> ios.kit.kavita
  ios.kit.libraryFeature -[dependsOn]-> ios.kit.smb

  ios.kit.readerFeature -[dependsOn]-> ios.kit.designSystem
  ios.kit.readerFeature -[dependsOn]-> ios.kit.core
  ios.kit.readerFeature -[dependsOn]-> ios.kit.formats
  ios.kit.readerFeature -[dependsOn]-> ios.kit.persistence

  ios.kit.settingsFeature -[dependsOn]-> ios.kit.designSystem
  ios.kit.settingsFeature -[dependsOn]-> ios.kit.core
  ios.kit.settingsFeature -[dependsOn]-> ios.kit.persistence
  ios.kit.settingsFeature -[dependsOn]-> shared.licences

  ios.epubPackage.epubReaderFeature -[dependsOn]-> ios.kit.designSystem
  ios.epubPackage.epubReaderFeature -[dependsOn]-> ios.kit.core
  ios.epubPackage.epubReaderFeature -[dependsOn]-> ios.kit.persistence
  ios.epubPackage.epubReaderFeature -[dependsOn]-> shared.fonts

  ios.kit.formats -[dependsOn]-> shared.libarchive 'compiles, via SwiftPM'

  // ---------------------------------------------------------------------
  // Android build graph. Transcribed from the build.gradle.kts files.
  // ---------------------------------------------------------------------

  android.androidApp -[dependsOn]-> android.coreDesignSystem
  android.androidApp -[dependsOn]-> android.coreModel
  android.androidApp -[dependsOn]-> android.coreFormat
  android.androidApp -[dependsOn]-> android.corePersistence
  android.androidApp -[dependsOn]-> android.coreCatalogue
  android.androidApp -[dependsOn]-> android.coreKavita
  android.androidApp -[dependsOn]-> android.coreSmb
  android.androidApp -[dependsOn]-> android.featureLibrary
  android.androidApp -[dependsOn]-> android.featureReader
  android.androidApp -[dependsOn]-> android.featureEpubReader
  android.androidApp -[dependsOn]-> android.featureSettings

  android.coreDesignSystem -[dependsOn]-> android.coreModel
  android.coreFormat -[dependsOn]-> android.coreModel
  android.corePersistence -[dependsOn]-> android.coreModel
  android.coreCatalogue -[dependsOn]-> android.coreModel
  android.coreKavita -[dependsOn]-> android.coreModel
  android.coreKavita -[dependsOn]-> android.coreCatalogue
  android.coreSmb -[dependsOn]-> android.coreFormat

  android.featureLibrary -[dependsOn]-> android.coreDesignSystem
  android.featureLibrary -[dependsOn]-> android.coreModel
  android.featureLibrary -[dependsOn]-> android.coreFormat
  android.featureLibrary -[dependsOn]-> android.corePersistence
  android.featureLibrary -[dependsOn]-> android.coreCatalogue
  android.featureLibrary -[dependsOn]-> android.coreKavita
  android.featureLibrary -[dependsOn]-> android.coreSmb

  android.featureReader -[dependsOn]-> android.coreDesignSystem
  android.featureReader -[dependsOn]-> android.coreModel
  android.featureReader -[dependsOn]-> android.coreFormat
  android.featureReader -[dependsOn]-> android.corePersistence

  android.featureEpubReader -[dependsOn]-> android.coreDesignSystem
  android.featureEpubReader -[dependsOn]-> android.coreModel
  android.featureEpubReader -[dependsOn]-> android.corePersistence

  android.featureSettings -[dependsOn]-> android.coreDesignSystem
  android.featureSettings -[dependsOn]-> android.coreModel
  android.featureSettings -[dependsOn]-> android.corePersistence

  android.coreFormat -[dependsOn]-> shared.libarchive 'compiles, via CMake and the NDK'

  // ---------------------------------------------------------------------
  // What each app reaches out to. The two connector sets mirror each other.
  // ---------------------------------------------------------------------

  ios.kit.formats -[reads]-> deviceStorage 'ranged reads'
  ios.kit.smb -[reads]-> smbShare 'ranged reads over SMB 2/3'
  ios.kit.catalogue -[reads]-> opdsCatalogue 'fetches feeds'
  ios.kit.kavita -[reads]-> kavitaServer 'calls the REST API'

  android.coreFormat -[reads]-> deviceStorage 'ranged reads'
  android.coreSmb -[reads]-> smbShare 'ranged reads over SMB 2/3'
  android.coreCatalogue -[reads]-> opdsCatalogue 'fetches feeds'
  android.coreKavita -[reads]-> kavitaServer 'calls the REST API'
}
